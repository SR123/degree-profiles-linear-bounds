/- Cycle 010: finite sparse-row coordinate identities, with no orbit-decoder premise. -/
import RankThreeInverseData
set_option autoImplicit false
set_option maxHeartbeats 0
set_option maxRecDepth 100000
set_option exponentiation.threshold 2048
namespace SelfContainedCycle010
open SelfContainedCycle009
abbrev Raw := Fin 1331
abbrev ImageCoord := Fin 390

def representativeCodes (i : ℕ) : ℕ := ( >>> (11*i)) % 2048
def lookupCodes (i : ℕ) : ℕ := ( >>> (10*i)) % 1024
def inversePerm0 (i : ℕ) : ℕ := (1144165528450 >>> (4*i)) % 16
def inversePerm1 (i : ℕ) : ℕ := (4853716054930 >>> (4*i)) % 16
def inversePerm2 (i : ℕ) : ℕ := (2449883597140 >>> (4*i)) % 16
def digits (x : ℕ) : ℕ × ℕ × ℕ := (x/121%11,x/11%11,x%11)
def encode (a b c : ℕ) : ℕ := 121*a+11*b+c
def mapCode (f : ℕ → ℕ) (x : ℕ) : ℕ := let d := digits x; encode (f d.1) (f d.2.1) (f d.2.2)
def blockCode (k x : ℕ) : ℕ := mapCode (fun a => if a<4 then a ^^^ k else a) x
def good (x : ℕ) : Bool := let d := digits x; d.1 != d.2.1 && d.1 != d.2.2 && d.2.1 != d.2.2

def Erow (x : Raw) : List (ImageCoord × Fin 4) :=
  let c := lookupCodes x.val
  let i := (c-1)/4
  let k := (c-1)%4
  let a := Fin.ofNat 390 (2*i)
  let b := Fin.ofNat 390 (2*i+1)
  if c=0 then [] else
    if k=0 then [(a,3),(b,1)] else
    if k=1 then [(a,1),(b,3)] else
    if k=2 then [(a,2)] else [(b,2)]
def Lrow (i : ImageCoord) : List (Raw × Fin 4) :=
  [(Fin.ofNat 1331 (blockCode (2+i.val%2) (representativeCodes (i.val/2))),3)]
def Zrow (x : Raw) : List (Raw × Fin 4) :=
  if good x.val then [(x,3),(Fin.ofNat 1331 (blockCode 1 x.val),1),
    (Fin.ofNat 1331 (blockCode 2 x.val),2)] else []
def Arow (x : Raw) : List (Raw × Fin 4) :=
  [(Fin.ofNat 1331 (mapCode inversePerm0 x.val),2),
   (Fin.ofNat 1331 (mapCode inversePerm1 x.val),3),
   (Fin.ofNat 1331 (mapCode inversePerm2 x.val),2)]
def unitBits {n : ℕ} (i : Fin n) : Bits := (1 <<< i.val,0)
def Ebits (x : Raw) : Bits := combineBits (Erow x) unitBits
def Zbits (x : Raw) : Bits := combineBits (Zrow x) unitBits
def Bbits (i : ImageCoord) : Bits := combineBits (sparseRows i) unitBits

end SelfContainedCycle010
