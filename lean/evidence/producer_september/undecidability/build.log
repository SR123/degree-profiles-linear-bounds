  match x with
  | 1 => psi1
  | 2 => eta
  | 3 => psi3 p
  | 4 => bhat
  | x => psi1
info: UAudit.lean:41:0: def ClaudeUndec.wrank : ℕ → ℕ :=
fun x =>
  match x with
  | 1 => 0
  | 4 => 1
  | 3 => 2
  | 2 => 3
  | x => 4
