'LinearFinal.linear_classification' depends on axioms: [propext, Classical.choice, Quot.sound]
'LinearFinal.topWitnessHypothesis_linear' depends on axioms: [propext, Classical.choice, Quot.sound]
'LinearFinal.exactness_linear' depends on axioms: [propext, Classical.choice, Quot.sound]
'RForce.forceExists' depends on axioms: [propext, Classical.choice, Quot.sound]
'BRealise.realisationFromForce' depends on axioms: [propext, Classical.choice, Quot.sound]
'BFinalLinear.linear_of_forceExists' depends on axioms: [propext, Classical.choice, Quot.sound]
'BExact.topWitnessHypothesis_of_dcp'' depends on axioms: [propext, Classical.choice, Quot.sound]
'BExact.prop6PatHyp_of_generic' depends on axioms: [propext, Classical.choice, Quot.sound]
'ClaudeDCP.linear_of_halfSq2' depends on axioms: [propext, Classical.choice, Quot.sound]
'ClaudeLinear.linear_of_exactness' depends on axioms: [propext, Classical.choice, Quot.sound]
linear_classification : ∀ (p : ℕ) [Fact (Nat.Prime p)] {R : Type} [inst : Field R] [CharP R p]
  (T : DegreeProfilesReview.Uniform.Template R),
  ∀ h ∈ {T.pcProfile, T.nsProfile},
    DegreeProfilesReview.Profiles.PeriodicProfile h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0)
        (DegreeProfilesReview.Profiles.period p T.k T.s) ∧
      (DegreeProfilesReview.Profiles.IsT1 h ∧
            ¬DegreeProfilesReview.Profiles.IsT2 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) ∧
              ¬DegreeProfilesReview.Profiles.IsT3 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) ∧
                ¬DegreeProfilesReview.Profiles.IsT4 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) ∨
          ¬DegreeProfilesReview.Profiles.IsT1 h ∧
              DegreeProfilesReview.Profiles.IsT2 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) ∧
                ¬DegreeProfilesReview.Profiles.IsT3 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) ∧
                  ¬DegreeProfilesReview.Profiles.IsT4 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) ∨
            ¬DegreeProfilesReview.Profiles.IsT1 h ∧
                ¬DegreeProfilesReview.Profiles.IsT2 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) ∧
                  DegreeProfilesReview.Profiles.IsT3 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) ∧
                    ¬DegreeProfilesReview.Profiles.IsT4 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) ∨
              ¬DegreeProfilesReview.Profiles.IsT1 h ∧
                ¬DegreeProfilesReview.Profiles.IsT2 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) ∧
                  ¬DegreeProfilesReview.Profiles.IsT3 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) ∧
                    DegreeProfilesReview.Profiles.IsT4 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0)) ∧
        (DegreeProfilesReview.Profiles.IsT2 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) →
            ∀ (n x : ℕ), T.n0 ≤ n → h n = ↑x → (↑n - 2 * ↑T.s - 1) / (2 * ↑T.k) < ↑x) ∧
          (DegreeProfilesReview.Profiles.IsT3 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) →
              ∃ D U,
                U.Nonempty ∧
                  (∃ c < DegreeProfilesReview.Profiles.period p T.k T.s D, c ∉ U) ∧
                    ∀ (n : ℕ),
                      DegreeProfilesReview.Profiles.onset T.k T.s T.n0 D ≤ n →
                        2 * T.k + 2 * T.s + 1 ≤ n →
                          n % DegreeProfilesReview.Profiles.period p T.k T.s D ∉ U →
                            ↑((n - 2 * T.s - 1) / (2 * T.k)) < h n) ∧
            (DegreeProfilesReview.Profiles.IsT4 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) →
              ∀ (B : ℕ),
                ∃ n d,
                  B ≤ n ∧
                    B ≤ d ∧
                      d ∈ DegreeProfilesReview.Profiles.E h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) ∧
                        h n = ↑d ∧ n ≤ (p + 2) * (T.k * d + T.s) ∧ ↑n / ((↑p + 2) * ↑T.k) - ↑T.s / ↑T.k ≤ ↑d)
topWitnessHypothesis_linear : ∀ (p : ℕ) [inst : Fact (Nat.Prime p)] (L : Type) [inst_1 : Field L] [IsAlgClosed L]
  [inst_3 : CharP L p], ClaudeCP.TopWitnessHypothesis p L fun r => 2 * r - 1
exactness_linear : ∀ (p : ℕ) [inst : Fact (Nat.Prime p)] (L : Type) [inst_1 : Field L] [IsAlgClosed L]
  [inst_3 : CharP L p], ClaudeLinear.ExactnessHypothesis p L fun r => 2 * r - 1
def ClaudeCP.TopWitnessHypothesis : (p : ℕ) →
  [Fact (Nat.Prime p)] → (L : Type) → [inst : Field L] → [CharP L p] → (ℕ → ℕ) → Prop :=
fun p [Fact (Nat.Prime p)] L [Field L] [CharP L p] W =>
  ∀ (r a n : ℕ),
    r < p ^ a → W r ≤ n → ∃ c, DegreeProfilesReview.Shifted.Generic p c ∧ ∃ w, ClaudeCP.IsTopWitness p r a n c w
def ClaudeCP.IsTopWitness : {K : Type} →
  [inst : Field K] →
    (p : ℕ) →
      [Fact (Nat.Prime p)] →
        ℕ → (a n : ℕ) → (Fin a → K) → MonoidAlgebra K ↥(DegreeProfilesReview.SymRep.Sfin (n + p ^ a)) → Prop :=
fun {K} [Field K] p [Fact (Nat.Prime p)] r a n c w =>
  ClaudeCP.zEltP p a n c ^ (p - 1) * w * ClaudeCP.zEltP p a n c ^ (p - 1) - ClaudeCP.zEltP p a n c ^ (p - 1) ∈
    SelfContainedCycle003.TupleRelations K r (n + p ^ a)
def DegreeProfilesReview.Profiles.onset : ℕ → ℕ → ℕ → ℕ → ℕ :=
fun k s n0 d => if d = 0 then n0 else max n0 (2 * (k * d + s) + 1)
def DegreeProfilesReview.Profiles.period : ℕ → ℕ → ℕ → ℕ → ℕ :=
fun p k s d => if d = 0 then 1 else DegreeProfilesReview.Profiles.leastPowGt p (k * d + s)
def DegreeProfilesReview.Profiles.IsT2 : (ℕ → ℕ∞) → (ℕ → ℕ) → Prop :=
fun h N => DegreeProfilesReview.Profiles.E h N = ∅
