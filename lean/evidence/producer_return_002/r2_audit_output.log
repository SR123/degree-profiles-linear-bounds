  {T : DegreeProfilesReview.Uniform.Template R} (G : ITarget T) (o : G.B.Obj) {d a n : ℕ},
  T.n0 ≤ n →
    G.aux.n0 ≤ n →
      2 * G.supp d - 1 ≤ n →
        G.supp d < p ^ a →
          ∀ {bN : G.B.Rk (n + p ^ a)},
            G.InOrbit o bN →
              ∀ {bn : G.B.Rk n},
                G.InOrbit o bn →
                  (G.poly (n + p ^ a) bN ∈ DegreeProfilesReview.PC.Vinf (T.inst (n + p ^ a)) d ↔
                      G.poly n bn ∈ DegreeProfilesReview.PC.Vinf (T.inst n) d) ∧
                    (G.poly (n + p ^ a) bN ∈ DegreeProfilesReview.NS.NSspan (T.inst (n + p ^ a)) d ↔
