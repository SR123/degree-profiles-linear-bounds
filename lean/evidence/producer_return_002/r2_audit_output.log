  {T : DegreeProfilesReview.Uniform.Template R} (G : ITarget T) {d a n : ℕ},
  T.n0 ≤ n →
    G.aux.n0 ≤ n →
      2 * G.supp d - 1 ≤ n →
        G.supp d < p ^ a →
          ((∀ (b : G.B.Rk (n + p ^ a)), DegreeProfilesReview.PC.Derives (T.inst (n + p ^ a)) d (G.poly (n + p ^ a) b)) ↔
              ∀ (b : G.B.Rk n), DegreeProfilesReview.PC.Derives (T.inst n) d (G.poly n b)) ∧
            ((∀ (b : G.B.Rk (n + p ^ a)), NSDerives (T.inst (n + p ^ a)) d (G.poly (n + p ^ a) b)) ↔
              ∀ (b : G.B.Rk n), NSDerives (T.inst n) d (G.poly n b))
