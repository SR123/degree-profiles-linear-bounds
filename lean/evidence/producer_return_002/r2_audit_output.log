                ((∀ (b : G.B.Rk (n + p ^ a)), NSDerives (T.inst (n + p ^ a)) d (G.poly (n + p ^ a) b)) ↔
                  ∀ (b : G.B.Rk n), NSDerives (T.inst n) d (G.poly n b))) ∧
    DegreeProfilesReview.Uniform.LinearBoundsFor p (2 * T.k) (T.s + G.t) G.nI G.pcProfile ∧
      DegreeProfilesReview.Uniform.LinearBoundsFor p (2 * T.k) (T.s + G.t) G.nI G.nsProfile ∧
