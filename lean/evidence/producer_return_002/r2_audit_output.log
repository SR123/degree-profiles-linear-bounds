                    DegreeProfilesReview.Profiles.E G.pcProfile
                      (DegreeProfilesReview.Profiles.onset (2 * T.k) (T.s + G.t) G.nI) ∧
                  G.pcProfile n = ↑d ∧
                    ↑d ≤ G.nsProfile n ∧
                      G.nsProfile n ≤ ↑(F d) ∧
                        n ≤ (p + 2) * (2 * T.k * d + (T.s + G.t)) ∧
