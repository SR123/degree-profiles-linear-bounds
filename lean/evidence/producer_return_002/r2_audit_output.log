indexed_transfer : ∀ (p : ℕ) [Fact (Nat.Prime p)] {R : Type} [inst : Field R] [CharP R p]
  {T : DegreeProfilesReview.Uniform.Template R} (G : ITarget T) {d a n : ℕ},
  T.n0 ≤ n →
    G.aux.n0 ≤ n →
      2 * G.supp d - 1 ≤ n →
        G.supp d < p ^ a → (G.AllPC (n + p ^ a) d ↔ G.AllPC n d) ∧ (G.AllNS (n + p ^ a) d ↔ G.AllNS n d)
