@ClaudeCP.topProjectionEquiv : {K : Type} →
  [inst : Field K] →
    {p : ℕ} →
      [inst_1 : Fact (Nat.Prime p)] →
        [inst_2 : CharP K p] →
          {r a n : ℕ} →
            {c : Fin a → K} →
              DegreeProfilesReview.Shifted.Generic p c →
                r < p ^ a →
                  {w : MonoidAlgebra K ↥(DegreeProfilesReview.SymRep.Sfin (n + p ^ a))} →
                    ClaudeCP.IsTopWitness p r a n c w →
                      (M : Rep K ↥(DegreeProfilesReview.SymRep.Sfin (n + p ^ a))) →
                        SelfContainedCycle003.CanonicalClass K r (n + p ^ a) M →
                          ↑((DegreeProfilesReview.ShiftedM5.Ψhat p a n c).obj M).V ≃ₗ[K]
                            ↥(LinearMap.range (ClaudeCP.topProj c w M))
@ClaudeCP.topElt_relations : ∀ {K : Type} [inst : Field K] {p : ℕ} [inst_1 : Fact (Nat.Prime p)] [inst_2 : CharP K p]
  {r a n : ℕ} {c : Fin a → K},
  DegreeProfilesReview.Shifted.Generic p c →
    r < p ^ a →
      ∀ {w : MonoidAlgebra K ↥(DegreeProfilesReview.SymRep.Sfin (n + p ^ a))},
        ClaudeCP.IsTopWitness p r a n c w →
          ClaudeCP.zEltP p a n c * ClaudeCP.topElt p a n c w ∈ SelfContainedCycle003.TupleRelations K r (n + p ^ a) ∧
            ClaudeCP.topElt p a n c w * ClaudeCP.zEltP p a n c ∈ SelfContainedCycle003.TupleRelations K r (n + p ^ a) ∧
              ClaudeCP.topElt p a n c w * ClaudeCP.topElt p a n c w - ClaudeCP.topElt p a n c w ∈
                SelfContainedCycle003.TupleRelations K r (n + p ^ a)
