@BExact.piRel_spec : ∀ {R : Type} [inst : CommRing R] {ι : Type} [inst_1 : Fintype ι] [inst_2 : DecidableEq ι]
  {α : Type} [inst_3 : Fintype α] [inst_4 : DecidableEq α] (C : BExact.Chooser α) (m : ℕ) (Rr S : Finset ι)
  (L : Finset α),
  S.card ≤ m → Rr ⊆ S → Rr.card + S.card + 1 ≤ L.card → BExact.IsPartition (BExact.piRel C m Rr L) Rr S L
@BExact.cone_spec : ∀ {R : Type} [inst : CommRing R] {ι : Type} [inst_1 : Fintype ι] [inst_2 : DecidableEq ι] {α : Type}
  [inst_3 : Fintype α] [inst_4 : DecidableEq α] (C : BExact.Chooser α) (m : ℕ) (Rr : Finset ι) (L : Finset α)
  (js : List ι),
  js.Nodup →
    (∀ j ∈ js, j ∉ Rr) →
      2 * Rr.card + js.length ≤ L.card →
        Rr.card + js.length ≤ m →
          ∀ Ψ ∈ BExact.Soc Rr Rr L,
            (BExact.cone C m Rr L js) Ψ ∈ BExact.Soc Rr (Rr ∪ js.toFinset) L ∧
              (BExact.delList js) ((BExact.cone C m Rr L js) Ψ) = Ψ
@BExact.blockSection_spec : ∀ {R : Type} [inst : CommRing R] {ι : Type} [inst_1 : Fintype ι] [inst_2 : DecidableEq ι]
  {α : Type} [inst_3 : Fintype α] [inst_4 : DecidableEq α] (C : BExact.Chooser α) {Lr : Finset α} {Bl : List α},
  Bl.Nodup →
    Disjoint Lr Bl.toFinset →
      ∀ {k : ℕ},
        1 ≤ k →
          2 * Fintype.card ι ≤ Lr.card + 1 →
            ∀ {g : BExact.Fn R ι α},
              g ∈ BExact.Gr Lr Bl.toFinset k →
                (BExact.blockSection C Lr Bl k) g ∈ BExact.Filt Lr Bl.toFinset k ∧
                  (BExact.topPart Bl.toFinset k) ((BExact.blockSection C Lr Bl k) g) = g
@BExact.nilSection_spec : ∀ {K : Type u_1} [inst : Field K] {M : Type u_2} [inst_1 : AddCommGroup M]
  [inst_2 : Module K M] (q : ℕ) (z : Module.End K M) (E Q Q₀ : Submodule K M) (f σ : Module.End K M),
  (∀ x ∈ Q, σ x ∈ E ∧ f (σ x) = x) →
    (∀ e ∈ E, f (z e) = z (f e)) →
      (∀ e ∈ E, z e ∈ E) →
        (∀ e ∈ E, (z ^ (q + 1)) e = 0) →
          LinearMap.range (BExact.zSum (q + 1) z Q₀) = Q →
            Function.Injective ⇑(BExact.zSum (q + 1) z Q₀) →
              (∀ c ∈ Q₀, (z ^ (q + 1)) c = 0) →
                ∃ τ,
                  (∀ x ∈ Q, τ x ∈ E ∧ f (τ x) = x) ∧
                    (∀ x ∈ Q, τ (z x) = z (τ x)) ∧
                      ∀ (γ : Module.End K M),
                        γ * z = z * γ →
                          (∀ c ∈ Q₀, γ c ∈ Q₀) → (∀ c ∈ Q₀, σ (γ c) = γ (σ c)) → ∀ x ∈ Q, τ (γ x) = γ (τ x)
@BExact.thm5_filt : ∀ {K : Type} [inst : Field K] {p : ℕ} [inst_1 : Fact (Nat.Prime p)] [CharP K p] {a n b : ℕ}
  {c : Fin a → K},
  BExact.Prop6Hyp p a n b c →
    2 * b ≤ n + 1 →
      ∀ k ≤ b,
        ∃ C,
          (∀ (σ : Equiv.Perm (Fin b)), ∀ x ∈ C, (BExact.rowAct σ) x ∈ C) ∧
            C ≤ BExact.Filt (BExact.Lr n (n + p ^ a)) (BExact.Bk n (n + p ^ a)) k ∧
              (∀ s ∈ BExact.Filt (BExact.Lr n (n + p ^ a)) (BExact.Bk n (n + p ^ a)) k,
                  ∃ s₀ ∈ BExact.Filt (BExact.Lr n (n + p ^ a)) (BExact.Bk n (n + p ^ a)) 0,
                    ∃ x ∈ LinearMap.range (BExact.zSum (p - 1 + 1) (BExact.rhoFn (ClaudeCP.zEltP p a n c)) C),
                      s = s₀ + x) ∧
                (∀ s₀ ∈ BExact.Filt (BExact.Lr n (n + p ^ a)) (BExact.Bk n (n + p ^ a)) 0,
                    ∀ x ∈ LinearMap.range (BExact.zSum (p - 1 + 1) (BExact.rhoFn (ClaudeCP.zEltP p a n c)) C),
                      s₀ + x = 0 → s₀ = 0) ∧
                  Function.Injective ⇑(BExact.zSum (p - 1 + 1) (BExact.rhoFn (ClaudeCP.zEltP p a n c)) C)
@BExact.P1_concrete : ∀ {K : Type} [inst : Field K] {p : ℕ} [inst_1 : Fact (Nat.Prime p)] [CharP K p] {a n b : ℕ}
  {c : Fin a → K},
  BExact.Prop6Hyp p a n b c →
    2 * b ≤ n + 1 →
      ∀ v ∈ BExact.P Finset.univ Finset.univ,
        (BExact.rhoFn (ClaudeCP.zEltP p a n c) ^ (p - 1)) v ∈ BExact.Soc Finset.univ Finset.univ Finset.univ →
          ∃ s ∈ BExact.Soc Finset.univ Finset.univ Finset.univ,
            (BExact.rhoFn (ClaudeCP.zEltP p a n c) ^ (p - 1)) v = (BExact.rhoFn (ClaudeCP.zEltP p a n c) ^ (p - 1)) s
@BExact.Tsoc_concrete : ∀ {K : Type} [inst : Field K] {p : ℕ} [inst_1 : Fact (Nat.Prime p)] [CharP K p] {a n b : ℕ}
  {c : Fin a → K},
  BExact.Prop6Hyp p a n b c →
    2 * b ≤ n + 1 →
      ∃ wS,
        (∀ s ∈ BExact.Soc Finset.univ Finset.univ Finset.univ, wS s ∈ BExact.Soc Finset.univ Finset.univ Finset.univ) ∧
          (∀ s ∈ BExact.Soc Finset.univ Finset.univ Finset.univ,
              (BExact.rhoFn (ClaudeCP.zEltP p a n c) ^ (p - 1))
                  (wS ((BExact.rhoFn (ClaudeCP.zEltP p a n c) ^ (p - 1)) s)) =
                (BExact.rhoFn (ClaudeCP.zEltP p a n c) ^ (p - 1)) s) ∧
            ∀ (σ : Equiv.Perm (Fin b)),
              ∀ s ∈ BExact.Soc Finset.univ Finset.univ Finset.univ, (BExact.rowAct σ) (wS s) = wS ((BExact.rowAct σ) s)
@BExact.P2_of_transpose : ∀ {K : Type u_1} [inst : Field K] {M : Type u_2} [inst_1 : AddCommGroup M]
  [inst_2 : Module K M] [FiniteDimensional K M] (B : LinearMap.BilinForm K M),
  (∀ (x y : M), (B x) y = (B y) x) →
    B.Nondegenerate →
      ∀ (P V' Soc : Submodule K M) (E : Module.End K M),
        (∀ x ∈ P, E x = x) →
          (∀ (x : M), E x ∈ P) →
            (∀ (x y : M), (B (E x)) y = (B x) (E y)) →
              V' ≤ P →
                (∀ x ∈ P, (∀ v ∈ V', (B v) x = 0) → x ∈ Soc) →
                  (∀ v ∈ V', ∀ s ∈ Soc, (B v) s = 0) →
                    ∀ (u u' : Module.End K M),
                      (∀ (x y : M), (B (u x)) y = (B x) (u' y)) →
                        (∀ x ∈ P, u x ∈ P) →
                          (∀ x ∈ P, u' x ∈ P) →
                            (∀ y ∈ P, u' y ∈ Soc → ∃ s ∈ Soc, u' y = u' s) → ∀ v ∈ P, u v ∈ V' → ∃ v' ∈ V', u v = u v'
@BExact.Ttop_of_transpose : ∀ {K : Type u_1} [inst : Field K] {M : Type u_2} [inst_1 : AddCommGroup M]
  [inst_2 : Module K M] [FiniteDimensional K M] (B : LinearMap.BilinForm K M),
  B.Nondegenerate →
    ∀ (P V' Soc : Submodule K M) (E : Module.End K M),
      (∀ x ∈ P, E x = x) →
        (∀ (x : M), E x ∈ P) →
          (∀ (x y : M), (B (E x)) y = (B x) (E y)) →
            Soc ≤ P →
              (∀ x ∈ P, (∀ s ∈ Soc, (B x) s = 0) → x ∈ V') →
                (∀ v ∈ V', ∀ s ∈ Soc, (B v) s = 0) →
                  ∀ (u u' : Module.End K M),
                    (∀ (x y : M), (B (u x)) y = (B x) (u' y)) →
                      (∀ x ∈ P, u x ∈ P) →
                        (∀ x ∈ P, u' x ∈ P) →
                          ∀ (w' : Module.End K M),
                            (∀ s ∈ Soc, w' s ∈ Soc) →
                              (∀ s ∈ Soc, u' (w' (u' s)) = u' s) →
                                ∀ (G : Set (Module.End K M)),
                                  (∀ g ∈ G, ∀ x ∈ P, g x ∈ P) →
                                    (∀ g ∈ G,
                                        ∃ g',
                                          (∀ (x y : M), (B (g x)) y = (B x) (g' y)) ∧
                                            (∀ s ∈ Soc, g' s ∈ Soc) ∧ ∀ s ∈ Soc, g' (w' s) = w' (g' s)) →
                                      ∃ wT,
                                        (∀ (x : M), wT x ∈ P) ∧
                                          (∀ v ∈ V', wT v ∈ V') ∧
                                            (∀ v ∈ P, u (wT (u v)) - u v ∈ V') ∧
                                              ∀ g ∈ G, ∀ v ∈ P, g (wT v) - wT (g v) ∈ V'
@BExact.layer_step : ∀ {K : Type u_1} [inst : Field K] {A : Type u_2} [inst_1 : Ring A] [inst_2 : Algebra K A]
  {V : Type u_3} [inst_3 : AddCommGroup V] [inst_4 : Module K V] (ρ : A →ₐ[K] Module.End K V) (J : Set A),
  (∀ x ∈ J, ∀ y ∈ J, x + y ∈ J) →
    (∀ x ∈ J, ∀ (y z : A), y * x * z ∈ J) →
      ∀ (Soc V' : Submodule K V) (G : Set (Module.End K V)),
        (∀ g ∈ G, ∀ (a : A), g * ρ a = ρ a * g) →
          (∀ x ∈ J, ∀ (v : V), (ρ x) v ∈ Soc) →
            (∀ x ∈ J, ∀ v ∈ V', (ρ x) v = 0) →
              (∀ (φ : Module.End K V),
                  (∀ (v : V), φ v ∈ Soc) → (∀ v ∈ V', φ v = 0) → (∀ g ∈ G, g * φ = φ * g) → ∃ x ∈ J, ρ x = φ) →
                ∀ (u : A),
                  (∀ (v : V), (ρ u) v ∈ Soc → ∃ s ∈ Soc, (ρ u) v = (ρ u) s) →
                    (∀ (v : V), (ρ u) v ∈ V' → ∃ v' ∈ V', (ρ u) v = (ρ u) v') →
                      ∀ (wS : Module.End K V),
                        (∀ s ∈ Soc, wS s ∈ Soc) →
                          (∀ s ∈ Soc, (ρ u) (wS ((ρ u) s)) = (ρ u) s) →
                            (∀ g ∈ G, ∀ s ∈ Soc, g (wS s) = wS (g s)) →
                              ∀ (wT : Module.End K V),
                                (∀ v ∈ V', wT v ∈ V') →
                                  (∀ (v : V), (ρ u) (wT ((ρ u) v)) - (ρ u) v ∈ V') →
                                    (∀ g ∈ G, ∀ (v : V), g (wT v) - wT (g v) ∈ V') →
                                      ∀ (w₀ : A),
                                        u * w₀ * u - u ∈ J →
                                          ∃ j ∈ J, u * (w₀ + j) * u - u ∈ J ∧ ρ (u * (w₀ + j) * u - u) = 0
