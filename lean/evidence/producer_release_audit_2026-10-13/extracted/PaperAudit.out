PaperAudit.periodicity_any_q : ∀ (p : ℕ) [Fact (Nat.Prime p)] {R : Type} [inst : Field R] [CharP R p]
  (T : DegreeProfilesReview.Uniform.Template R) {h : ℕ → ℕ∞},
  h = T.pcProfile ∨ h = T.nsProfile →
    ∀ {d a : ℕ},
      1 ≤ d →
        T.k * d + T.s < p ^ a →
          ∀ {n n' : ℕ},
            T.n0 ≤ n →
              T.n0 ≤ n' →
                2 * (T.k * d + T.s) < n →
                  2 * (T.k * d + T.s) < n' → n % p ^ a = n' % p ^ a → ∀ {t : ℕ}, t ≤ d → (h n ≤ ↑t ↔ h n' ≤ ↑t)
PaperAudit.degree_zero_stable : ∀ (p : ℕ) [Fact (Nat.Prime p)] {R : Type} [inst : Field R] [CharP R p]
  (T : DegreeProfilesReview.Uniform.Template R) {h : ℕ → ℕ∞},
  h = T.pcProfile ∨ h = T.nsProfile → ∀ {n n' : ℕ}, T.n0 ≤ n → T.n0 ≤ n' → (h n ≤ 0 ↔ h n' ≤ 0)
PaperAudit.E_eq_Rec : ∀ (p : ℕ) [Fact (Nat.Prime p)] {R : Type} [inst : Field R] [CharP R p]
  (T : DegreeProfilesReview.Uniform.Template R) {h : ℕ → ℕ∞},
  h = T.pcProfile ∨ h = T.nsProfile →
    DegreeProfilesReview.Profiles.E h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) = ClaudeUndec.Rec h
PaperAudit.T2_bound : ∀ (p : ℕ) [Fact (Nat.Prime p)] {R : Type} [inst : Field R] [CharP R p]
  (T : DegreeProfilesReview.Uniform.Template R) {h : ℕ → ℕ∞},
  h = T.pcProfile ∨ h = T.nsProfile →
    DegreeProfilesReview.Profiles.IsT2 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) →
      ∀ {n : ℕ}, T.n0 ≤ n → ↑((n - 2 * T.s - 1) / (2 * T.k)) < h n
PaperAudit.T3_full : ∀ (p : ℕ) [Fact (Nat.Prime p)] {R : Type} [inst : Field R] [CharP R p]
  (T : DegreeProfilesReview.Uniform.Template R) {h : ℕ → ℕ∞},
  h = T.pcProfile ∨ h = T.nsProfile →
    DegreeProfilesReview.Profiles.IsT3 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) →
      ∃ D ∈ DegreeProfilesReview.Profiles.E h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0),
        (∀ d ∈ DegreeProfilesReview.Profiles.E h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0), d ≤ D) ∧
          ∃ U,
            (∀ c ∈ U, c < DegreeProfilesReview.Profiles.period p T.k T.s D) ∧
              U.Nonempty ∧
                (∃ c < DegreeProfilesReview.Profiles.period p T.k T.s D, c ∉ U) ∧
                  (∀ c ∈ U,
                      ∃ v ≤ D,
                        ∀ (n : ℕ),
                          DegreeProfilesReview.Profiles.onset T.k T.s T.n0 D ≤ n →
                            n % DegreeProfilesReview.Profiles.period p T.k T.s D = c → h n = ↑v) ∧
                    ∀ (n : ℕ),
                      DegreeProfilesReview.Profiles.onset T.k T.s T.n0 D ≤ n →
                        n % DegreeProfilesReview.Profiles.period p T.k T.s D ∉ U →
                          ↑((n - 2 * T.s - 1) / (2 * T.k)) < h n
PaperAudit.liminf_classification : ∀ (p : ℕ) [Fact (Nat.Prime p)] {R : Type} [inst : Field R] [CharP R p]
  (T : DegreeProfilesReview.Uniform.Template R) {h : ℕ → ℕ∞},
  h = T.pcProfile ∨ h = T.nsProfile →
    (DegreeProfilesReview.Profiles.IsT1 h ∨
          DegreeProfilesReview.Profiles.IsT3 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) ∨
            DegreeProfilesReview.Profiles.IsT4 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) →
        ∃ e ∈ DegreeProfilesReview.Profiles.E h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0),
          (∀ x ∈ DegreeProfilesReview.Profiles.E h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0), e ≤ x) ∧
            Filter.liminf h Filter.atTop = ↑e) ∧
      (DegreeProfilesReview.Profiles.IsT2 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) →
        Filter.liminf h Filter.atTop = ⊤)
PaperAudit.common_peaks : ∀ (p : ℕ) [Fact (Nat.Prime p)] {R : Type} [inst : Field R] [CharP R p]
  (T : DegreeProfilesReview.Uniform.Template R),
  DegreeProfilesReview.Profiles.IsT4 T.pcProfile (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) →
    ∃ F,
      Monotone F ∧
        ∀ (B : ℕ),
          ∃ n d,
            B ≤ n ∧
              B ≤ d ∧
                d ∈ DegreeProfilesReview.Profiles.E T.pcProfile (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) ∧
                  T.pcProfile n = ↑d ∧
                    ↑d ≤ T.nsProfile n ∧
                      T.nsProfile n ≤ ↑(F d) ∧ n ≤ (p + 2) * (T.k * d + T.s) ∧ ↑n / ((↑p + 2) * ↑T.k) - ↑T.s / ↑T.k ≤ ↑d
PaperAudit.common_peaks_ns_T4 : ∀ (p : ℕ) [Fact (Nat.Prime p)] {R : Type} [inst : Field R] [CharP R p]
  (T : DegreeProfilesReview.Uniform.Template R),
  DegreeProfilesReview.Profiles.IsT4 T.pcProfile (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) →
    DegreeProfilesReview.Profiles.IsT4 T.nsProfile (DegreeProfilesReview.Profiles.onset T.k T.s T.n0)
PaperAudit.bhat_window : ∀ (p : ℕ) [hp : Fact (Nat.Prime p)] (K : Type) [inst : Field K] [CharP K p] {n a u : ℕ},
  ¬p ∣ u →
    n = p ^ a * u →
      2 * p ^ a ≤ n →
        ↑(p ^ a) ≤ (ClaudeUndec.template ClaudeUndec.bhat K).pcProfile n ∧
          (ClaudeUndec.template ClaudeUndec.bhat K).pcProfile n ≤
              (ClaudeUndec.template ClaudeUndec.bhat K).nsProfile n ∧
            (ClaudeUndec.template ClaudeUndec.bhat K).nsProfile n ≤ ↑(p ^ a + 4)
PaperAudit.bhat_peaks : ∀ (p : ℕ) [hp : Fact (Nat.Prime p)] (K : Type) [inst : Field K] [CharP K p] (a : ℕ),
  ↑((p + 1) * p ^ a / (p + 1)) ≤ (ClaudeUndec.template ClaudeUndec.bhat K).pcProfile ((p + 1) * p ^ a) ∧
    (ClaudeUndec.template ClaudeUndec.bhat K).pcProfile ((p + 1) * p ^ a) ≤
        (ClaudeUndec.template ClaudeUndec.bhat K).nsProfile ((p + 1) * p ^ a) ∧
      (ClaudeUndec.template ClaudeUndec.bhat K).nsProfile ((p + 1) * p ^ a) ≤ ↑((p + 1) * p ^ a / (p + 1) + 4)
PaperAudit.bhat_recurrence_sizes : ∀ (p : ℕ) [hp : Fact (Nat.Prime p)] (K : Type) [inst : Field K] [CharP K p]
  (a k : ℕ),
  ↑(p ^ a) ≤ (ClaudeUndec.template ClaudeUndec.bhat K).pcProfile (p ^ a * (p * (k + 1) + 1)) ∧
    (ClaudeUndec.template ClaudeUndec.bhat K).nsProfile (p ^ a * (p * (k + 1) + 1)) ≤ ↑(p ^ a + 4)
PaperAudit.chainBoundPerm_linear : ∀ (p : ℕ) [Fact (Nat.Prime p)] (K : Type) [inst : Field K] [IsAlgClosed K]
  [CharP K p] (𝒰 : DegreeProfilesReview.Uniform.BasisSystem) {r : ℕ},
  𝒰.Bounded r →
    ∀ (a : ℕ),
      r + r < p ^ a →
        ∀ (N : ℕ) (W : Fin (Nat.card (𝒰.Rk (4 * r + p ^ a)) + 2) → Submodule K (𝒰.Rk N →₀ K)),
          (∀ (i : Fin (Nat.card (𝒰.Rk (4 * r + p ^ a)) + 2)),
              ClaudeComparison.IsInv (DegreeProfilesReview.SymRep.permRep K 𝒰 N).ρ (W i)) →
            ¬StrictMono W
PaperAudit.chainBound_linear_explicit : ∀ (p : ℕ) [Fact (Nat.Prime p)] {R : Type} [inst : Field R] [CharP R p]
  (𝒰 : DegreeProfilesReview.Uniform.BasisSystem) {k : ℕ},
  𝒰.Bounded k →
    ∀ (t n : ℕ)
      (W :
        Fin (Nat.card ((𝒰.mon t).Rk (4 * (k * t) + p ^ (2 * (k * t) + 1))) + 2) →
          Submodule R (MvPolynomial (𝒰.Rk n) R)),
      (∀ (i : Fin (Nat.card ((𝒰.mon t).Rk (4 * (k * t) + p ^ (2 * (k * t) + 1))) + 2)),
          W i ≤ MvPolynomial.restrictTotalDegree (𝒰.Rk n) R t) →
        (∀ (i : Fin (Nat.card ((𝒰.mon t).Rk (4 * (k * t) + p ^ (2 * (k * t) + 1))) + 2))
            (g : ↥(DegreeProfilesReview.SymRep.Sfin n)), ∀ f ∈ W i, (MvPolynomial.rename fun v => g • v) f ∈ W i) →
          ¬StrictMono W
PaperAudit.upperComparison_linear_route : ∀ (p : ℕ) [Fact (Nat.Prime p)] {R : Type} [inst : Field R] [CharP R p]
  (T : DegreeProfilesReview.Uniform.Template R),
  ∃ F, Monotone F ∧ DegreeProfilesReview.Profiles.UpperComparison F T.pcProfile T.nsProfile
PaperAudit.dcpr_full : ∀ (K : Type) [inst : Field K] (b N : ℕ), ClaudeDCP.DCPR (Fin N) K b N
PaperAudit.topWitnessHypothesis_direct : ∀ (p : ℕ) [inst : Fact (Nat.Prime p)] (L : Type) [inst_1 : Field L]
  [IsAlgClosed L] [inst_3 : CharP L p], ClaudeCP.TopWitnessHypothesis p L fun r => 2 * r - 1
PaperAudit.exactness_direct : ∀ (p : ℕ) [inst : Fact (Nat.Prime p)] (L : Type) [inst_1 : Field L] [IsAlgClosed L]
  [inst_3 : CharP L p], ClaudeLinear.ExactnessHypothesis p L fun r => 2 * r - 1
