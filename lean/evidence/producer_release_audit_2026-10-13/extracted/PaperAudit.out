structure DegreeProfilesReview.Uniform.Template (R : Type) [Field R] : Type 1
number of parameters: 2
fields:
  DegreeProfilesReview.Uniform.Template.Var : DegreeProfilesReview.Uniform.BasisSystem
  DegreeProfilesReview.Uniform.Template.Ax : DegreeProfilesReview.Uniform.BasisSystem
  DegreeProfilesReview.Uniform.Template.k : ℕ
  DegreeProfilesReview.Uniform.Template.s : ℕ
  DegreeProfilesReview.Uniform.Template.D : ℕ
  DegreeProfilesReview.Uniform.Template.n0 : ℕ
  DegreeProfilesReview.Uniform.Template.hk : 1 ≤ self.k
  DegreeProfilesReview.Uniform.Template.hn0 : 1 ≤ self.n0
  DegreeProfilesReview.Uniform.Template.hn0' : self.k * self.D + self.s ≤ self.n0
  DegreeProfilesReview.Uniform.Template.var_bounded : self.Var.Bounded self.k
  DegreeProfilesReview.Uniform.Template.ax_bounded : self.Ax.Bounded self.s
  DegreeProfilesReview.Uniform.Template.coeff : self.Ax.Obj → (self.Var.Obj →₀ ℕ) → R
  DegreeProfilesReview.Uniform.Template.coeff_inv : ∀ (g : Equiv.Perm ℕ) (i : self.Ax.Obj) (m : self.Var.Obj →₀ ℕ),
      self.coeff (g • i) (self.Var.monSMul g m) = self.coeff i m
  DegreeProfilesReview.Uniform.Template.coeff_deg : ∀ (i : self.Ax.Obj) (m : self.Var.Obj →₀ ℕ),
      self.coeff i m ≠ 0 → DegreeProfilesReview.Uniform.BasisSystem.mdeg m ≤ self.D
constructor:
  DegreeProfilesReview.Uniform.Template.mk {R : Type} [Field R] (Var Ax : DegreeProfilesReview.Uniform.BasisSystem)
    (k s D n0 : ℕ) (hk : 1 ≤ k) (hn0 : 1 ≤ n0) (hn0' : k * D + s ≤ n0) (var_bounded : Var.Bounded k)
    (ax_bounded : Ax.Bounded s) (coeff : Ax.Obj → (Var.Obj →₀ ℕ) → R)
    (coeff_inv : ∀ (g : Equiv.Perm ℕ) (i : Ax.Obj) (m : Var.Obj →₀ ℕ), coeff (g • i) (Var.monSMul g m) = coeff i m)
    (coeff_deg :
      ∀ (i : Ax.Obj) (m : Var.Obj →₀ ℕ), coeff i m ≠ 0 → DegreeProfilesReview.Uniform.BasisSystem.mdeg m ≤ D) :
    DegreeProfilesReview.Uniform.Template R
structure DegreeProfilesReview.Uniform.BasisSystem : Type 1
number of parameters: 0
fields:
  DegreeProfilesReview.Uniform.BasisSystem.Obj : Type
  DegreeProfilesReview.Uniform.BasisSystem.act : MulAction (Equiv.Perm ℕ) self.Obj
  DegreeProfilesReview.Uniform.BasisSystem.supp : self.Obj → Finset ℕ
  DegreeProfilesReview.Uniform.BasisSystem.supp_smul : ∀ (g : Equiv.Perm ℕ) (u : self.Obj),
      self.supp (g • u) = Finset.image (⇑g) (self.supp u)
  DegreeProfilesReview.Uniform.BasisSystem.fixed : ∀ (g : Equiv.Perm ℕ) (u : self.Obj),
      (∀ x ∈ self.supp u, g x = x) → g • u = u
  DegreeProfilesReview.Uniform.BasisSystem.Rk : ℕ → Type
  DegreeProfilesReview.Uniform.BasisSystem.fin : ∀ (t : ℕ), Finite (self.Rk t)
  DegreeProfilesReview.Uniform.BasisSystem.up : (t : ℕ) → self.Rk t → self.Obj
  DegreeProfilesReview.Uniform.BasisSystem.up_inj : ∀ (t : ℕ), Function.Injective (self.up t)
  DegreeProfilesReview.Uniform.BasisSystem.range_up : ∀ (t : ℕ) (u : self.Obj),
      (∃ x, self.up t x = u) ↔ self.supp u ⊆ Finset.range t
constructor:
  DegreeProfilesReview.Uniform.BasisSystem.mk (Obj : Type) [act : MulAction (Equiv.Perm ℕ) Obj] (supp : Obj → Finset ℕ)
    (supp_smul : ∀ (g : Equiv.Perm ℕ) (u : Obj), supp (g • u) = Finset.image (⇑g) (supp u))
    (fixed : ∀ (g : Equiv.Perm ℕ) (u : Obj), (∀ x ∈ supp u, g x = x) → g • u = u) (Rk : ℕ → Type)
    [fin : ∀ (t : ℕ), Finite (Rk t)] (up : (t : ℕ) → Rk t → Obj) (up_inj : ∀ (t : ℕ), Function.Injective (up t))
    (range_up : ∀ (t : ℕ) (u : Obj), (∃ x, up t x = u) ↔ supp u ⊆ Finset.range t) :
    DegreeProfilesReview.Uniform.BasisSystem
def DegreeProfilesReview.Uniform.Template.pcProfile : {R : Type} →
  [inst : Field R] → DegreeProfilesReview.Uniform.Template R → ℕ → ℕ∞ :=
fun {R} [inst : Field R] T n => DegreeProfilesReview.PC.pcDegree (T.inst n)
def DegreeProfilesReview.Uniform.Template.nsProfile : {R : Type} →
  [inst : Field R] → DegreeProfilesReview.Uniform.Template R → ℕ → ℕ∞ :=
fun {R} [inst : Field R] T n => DegreeProfilesReview.NS.nsDegree (T.inst n)
structure DegreeProfilesReview.Profiles.PeriodicProfile (h : ℕ → ℕ∞) (N Q : ℕ → ℕ) : Prop
number of parameters: 3
fields:
  DegreeProfilesReview.Profiles.PeriodicProfile.N_mono : Monotone N
  DegreeProfilesReview.Profiles.PeriodicProfile.N_ge : ∀ (d : ℕ), d + 1 ≤ N d
  DegreeProfilesReview.Profiles.PeriodicProfile.Q_pos : ∀ (d : ℕ), 0 < Q d
  DegreeProfilesReview.Profiles.PeriodicProfile.periodic : ∀ (d t : ℕ),
      t ≤ d → ∀ (n m : ℕ), N d ≤ n → N d ≤ m → n % Q d = m % Q d → (h n ≤ ↑t ↔ h m ≤ ↑t)
constructor:
  DegreeProfilesReview.Profiles.PeriodicProfile.mk {h : ℕ → ℕ∞} {N Q : ℕ → ℕ} (N_mono : Monotone N)
    (N_ge : ∀ (d : ℕ), d + 1 ≤ N d) (Q_pos : ∀ (d : ℕ), 0 < Q d)
    (periodic : ∀ (d t : ℕ), t ≤ d → ∀ (n m : ℕ), N d ≤ n → N d ≤ m → n % Q d = m % Q d → (h n ≤ ↑t ↔ h m ≤ ↑t)) :
    DegreeProfilesReview.Profiles.PeriodicProfile h N Q
def DegreeProfilesReview.Profiles.onset : ℕ → ℕ → ℕ → ℕ → ℕ :=
fun k s n0 d => if d = 0 then n0 else max n0 (2 * (k * d + s) + 1)
def DegreeProfilesReview.Profiles.period : ℕ → ℕ → ℕ → ℕ → ℕ :=
fun p k s d => if d = 0 then 1 else DegreeProfilesReview.Profiles.leastPowGt p (k * d + s)
def DegreeProfilesReview.Profiles.leastPowGt : ℕ → ℕ → ℕ :=
fun p m => if hp : 2 ≤ p then p ^ Nat.find ⋯ else 1
def DegreeProfilesReview.Profiles.EventuallyBounded : (ℕ → ℕ∞) → Prop :=
fun h => ∃ B M, ∀ (n : ℕ), M ≤ n → h n ≤ ↑B
def DegreeProfilesReview.Profiles.UpperComparison : (ℕ → ℕ) → (ℕ → ℕ∞) → (ℕ → ℕ∞) → Prop :=
fun F g h => ∀ (n x : ℕ), g n = ↑x → h n ≤ ↑(F x)
def ClaudeLinear.ExactnessHypothesis : (p : ℕ) →
  [Fact (Nat.Prime p)] → (L : Type) → [inst : Field L] → [CharP L p] → (ℕ → ℕ) → Prop :=
fun p [Fact (Nat.Prime p)] L [Field L] [CharP L p] W =>
  ∀ (r a n : ℕ),
    r < p ^ a → W r ≤ n → ∃ c, DegreeProfilesReview.Shifted.Generic p c ∧ ClaudeLinear.ShiftedExact p a n r c
def ClaudeLinear.ShiftedExact : {K : Type} →
  [Field K] → (p a : ℕ) → ℕ → ℕ → [Fact (Nat.Prime p)] → (Fin a → K) → Prop :=
fun {K} [Field K] p a n r [Fact (Nat.Prime p)] c =>
  CategoryTheory.Limits.PreservesFiniteLimits (SelfContainedCycle004.canonicalΨ p a n r c) ∧
    CategoryTheory.Limits.PreservesFiniteColimits (SelfContainedCycle004.canonicalΨ p a n r c)
def ClaudeCP.TopWitnessHypothesis : (p : ℕ) →
  [Fact (Nat.Prime p)] → (L : Type) → [inst : Field L] → [CharP L p] → (ℕ → ℕ) → Prop :=
fun p [Fact (Nat.Prime p)] L [Field L] [CharP L p] W =>
  ∀ (r a n : ℕ),
    r < p ^ a → W r ≤ n → ∃ c, DegreeProfilesReview.Shifted.Generic p c ∧ ∃ w, ClaudeCP.IsTopWitness p r a n c w
def ClaudeCP.IsTopWitness : {K : Type} →
  [inst : Field K] →
    (p : ℕ) →
      [Fact (Nat.Prime p)] →
        ℕ → (a n : ℕ) → (Fin a → K) → MonoidAlgebra K ↥(DegreeProfilesReview.SymRep.Sfin (n + p ^ a)) → Prop :=
fun {K} [Field K] p [Fact (Nat.Prime p)] r a n c w =>
  ClaudeCP.zEltP p a n c ^ (p - 1) * w * ClaudeCP.zEltP p a n c ^ (p - 1) - ClaudeCP.zEltP p a n c ^ (p - 1) ∈
    SelfContainedCycle003.TupleRelations K r (n + p ^ a)
def ClaudeCP.zEltP : {K : Type} →
  [inst : Field K] →
    (p : ℕ) →
      [Fact (Nat.Prime p)] →
        (a n : ℕ) → (Fin a → K) → MonoidAlgebra K ↥(DegreeProfilesReview.SymRep.Sfin (n + p ^ a)) :=
fun {K} [Field K] p [Fact (Nat.Prime p)] a n c =>
  ∑ i, c i • (MonoidAlgebra.single (DegreeProfilesReview.ShiftedM5.σgen p a n i) 1 - 1)
def SelfContainedCycle003.TupleRelations : (K : Type) →
  [inst : Field K] → ℕ → (t : ℕ) → Set (MonoidAlgebra K ↥(DegreeProfilesReview.SymRep.Sfin t)) :=
fun K [Field K] r t =>
  {a |
    ∀ b ≤ r,
      (DegreeProfilesReview.SymRep.permRep K (DegreeProfilesReview.ConcreteM4.injTuples b) t).ρ.asAlgebraHom a = 0}
def SelfContainedCycle003.CanonicalClass : (K : Type) →
  [inst : Field K] → ℕ → (t : ℕ) → CategoryTheory.ObjectProperty (Rep K ↥(DegreeProfilesReview.SymRep.Sfin t)) :=
fun K [Field K] r t => SelfContainedCycle003.AnnihilatedClass (SelfContainedCycle003.TupleRelations K r t)
def DegreeProfilesReview.Shifted.Generic.{u_2, u_3} : {ι : Type u_2} →
  [Fintype ι] → (p : ℕ) → [Fact (Nat.Prime p)] → {K : Type u_3} → [inst : Field K] → [CharP K p] → (ι → K) → Prop :=
fun {ι} [Fintype ι] p [Fact (Nat.Prime p)] {K} [Field K] [CharP K p] c =>
  ∀ (g : ι → ZMod p), ∑ i, c i * (ZMod.castHom ⋯ K) (g i) = 0 → g = 0
def DegreeProfilesReview.ShiftedM5.Ψhat : (p a n : ℕ) →
  [Fact (Nat.Prime p)] →
    {K : Type} →
      [inst : Field K] →
        (Fin a → K) →
          CategoryTheory.Functor (Rep K ↥(DegreeProfilesReview.SymRep.Sfin (n + p ^ a)))
            (Rep K ↥(DegreeProfilesReview.SymRep.Sfin n)) :=
fun p a n [Fact (Nat.Prime p)] {K} [Field K] c =>
  DegreeProfilesReview.ShiftedFunctor.scFunctor (DegreeProfilesReview.ShiftedM5.σgen p a n) c
    (DegreeProfilesReview.ConcreteM5.incl n (p ^ a)) ⋯
structure DegreeProfilesReview.Deletion.M5w.{v₂, v₃, v₄, u₂, u₃, u₄} {K : Type} [Field K] {r N n : ℕ} {BN : Type u₂}
  [CategoryTheory.Category.{v₂, u₂} BN] [CategoryTheory.Abelian BN] {Bn : Type u₂} [CategoryTheory.Category.{v₂, u₂} Bn]
  [CategoryTheory.Abelian Bn] (PN : DegreeProfilesReview.Deletion.M4 K r N BN)
  (Pn : DegreeProfilesReview.Deletion.M4 K r n Bn) (Φ : CategoryTheory.Functor BN Bn) :
  Type (max (max (max (max (max u₂ u₃) (u₄ + 1)) v₂) v₃) (v₄ + 1))
number of parameters: 14
fields:
  DegreeProfilesReview.Deletion.M5w.𝒯 : Type u₄
  DegreeProfilesReview.Deletion.M5w.cat𝒯 : CategoryTheory.Category.{v₄, u₄} self.𝒯
  DegreeProfilesReview.Deletion.M5w.mon𝒯 : CategoryTheory.MonoidalCategory self.𝒯
  DegreeProfilesReview.Deletion.M5w.J : CategoryTheory.Functor Pn.R self.𝒯
  DegreeProfilesReview.Deletion.M5w.J_monoidal : self.J.Monoidal
  DegreeProfilesReview.Deletion.M5w.J_full : self.J.Full
  DegreeProfilesReview.Deletion.M5w.J_faithful : self.J.Faithful
  DegreeProfilesReview.Deletion.M5w.Φhat : CategoryTheory.Functor PN.R self.𝒯
  DegreeProfilesReview.Deletion.M5w.γ : PN.ι.comp self.Φhat ≅ Φ.comp (Pn.ι.comp self.J)
  DegreeProfilesReview.Deletion.M5w.δ : (𝒰 : DegreeProfilesReview.Uniform.BasisSystem) →
      (h : 𝒰.Bounded r) → Φ.obj (PN.perm 𝒰 h) ≅ Pn.perm 𝒰 h
  DegreeProfilesReview.Deletion.M5w.δ_mat : ∀ {𝒰 𝒱 : DegreeProfilesReview.Uniform.BasisSystem} (hU : 𝒰.Bounded r)
      (hV : 𝒱.Bounded r) (a : DegreeProfilesReview.Uniform.InvMatrix K 𝒰 𝒱),
      CategoryTheory.CategoryStruct.comp (Φ.map (PN.mat hU hV a)) (self.δ 𝒱 hV).hom =
        CategoryTheory.CategoryStruct.comp (self.δ 𝒰 hU).hom (Pn.mat hU hV a)
  DegreeProfilesReview.Deletion.M5w.κ : {𝒰 : DegreeProfilesReview.Uniform.BasisSystem} →
      (hU : 𝒰.Bounded r) →
        (Y : PN.R) →
          self.Φhat.obj (CategoryTheory.MonoidalCategoryStruct.tensorObj (PN.ι.obj (PN.perm 𝒰 hU)) Y) ≅
            CategoryTheory.MonoidalCategoryStruct.tensorObj (self.J.obj (Pn.ι.obj (Pn.perm 𝒰 hU))) (self.Φhat.obj Y)
  DegreeProfilesReview.Deletion.M5w.κ_nat : ∀ {𝒰 : DegreeProfilesReview.Uniform.BasisSystem} (hU : 𝒰.Bounded r)
      {Y Y' : PN.R} (f : Y ⟶ Y'),
      CategoryTheory.CategoryStruct.comp
          (self.Φhat.map (CategoryTheory.MonoidalCategoryStruct.whiskerLeft (PN.ι.obj (PN.perm 𝒰 hU)) f))
          (self.κ hU Y').hom =
        CategoryTheory.CategoryStruct.comp (self.κ hU Y).hom
          (CategoryTheory.MonoidalCategoryStruct.whiskerLeft (self.J.obj (Pn.ι.obj (Pn.perm 𝒰 hU))) (self.Φhat.map f))
  DegreeProfilesReview.Deletion.M5w.δ_prod : ∀ {𝒰 𝒱 : DegreeProfilesReview.Uniform.BasisSystem} (hU : 𝒰.Bounded r)
      (hV : 𝒱.Bounded r) (hUV : (𝒰.prod 𝒱).Bounded r),
      CategoryTheory.CategoryStruct.comp (self.Φhat.map (PN.prodIso hU hV hUV).hom)
          (CategoryTheory.CategoryStruct.comp (self.γ.hom.app (PN.perm (𝒰.prod 𝒱) hUV))
            (self.J.map (Pn.ι.map (self.δ (𝒰.prod 𝒱) hUV).hom))) =
        CategoryTheory.CategoryStruct.comp (self.κ hU (PN.ι.obj (PN.perm 𝒱 hV))).hom
          (CategoryTheory.CategoryStruct.comp
            (CategoryTheory.MonoidalCategoryStruct.whiskerLeft (self.J.obj (Pn.ι.obj (Pn.perm 𝒰 hU)))
              (CategoryTheory.CategoryStruct.comp (self.γ.hom.app (PN.perm 𝒱 hV))
                (self.J.map (Pn.ι.map (self.δ 𝒱 hV).hom))))
            (CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Functor.LaxMonoidal.μ self.J (Pn.ι.obj (Pn.perm 𝒰 hU)) (Pn.ι.obj (Pn.perm 𝒱 hV)))
              (self.J.map (Pn.prodIso hU hV hUV).hom)))
constructor:
  DegreeProfilesReview.Deletion.M5w.mk.{v₂, v₃, v₄, u₂, u₃, u₄} {K : Type} [Field K] {r N n : ℕ} {BN : Type u₂}
    [CategoryTheory.Category.{v₂, u₂} BN] [CategoryTheory.Abelian BN] {Bn : Type u₂}
    [CategoryTheory.Category.{v₂, u₂} Bn] [CategoryTheory.Abelian Bn] {PN : DegreeProfilesReview.Deletion.M4 K r N BN}
    {Pn : DegreeProfilesReview.Deletion.M4 K r n Bn} {Φ : CategoryTheory.Functor BN Bn} (𝒯 : Type u₄)
    [cat𝒯 : CategoryTheory.Category.{v₄, u₄} 𝒯] [mon𝒯 : CategoryTheory.MonoidalCategory 𝒯]
    (J : CategoryTheory.Functor Pn.R 𝒯) [J_monoidal : J.Monoidal] [J_full : J.Full] [J_faithful : J.Faithful]
    (Φhat : CategoryTheory.Functor PN.R 𝒯) (γ : PN.ι.comp Φhat ≅ Φ.comp (Pn.ι.comp J))
    (δ : (𝒰 : DegreeProfilesReview.Uniform.BasisSystem) → (h : 𝒰.Bounded r) → Φ.obj (PN.perm 𝒰 h) ≅ Pn.perm 𝒰 h)
    (δ_mat :
      ∀ {𝒰 𝒱 : DegreeProfilesReview.Uniform.BasisSystem} (hU : 𝒰.Bounded r) (hV : 𝒱.Bounded r)
        (a : DegreeProfilesReview.Uniform.InvMatrix K 𝒰 𝒱),
        CategoryTheory.CategoryStruct.comp (Φ.map (PN.mat hU hV a)) (δ 𝒱 hV).hom =
          CategoryTheory.CategoryStruct.comp (δ 𝒰 hU).hom (Pn.mat hU hV a))
    (κ :
      {𝒰 : DegreeProfilesReview.Uniform.BasisSystem} →
        (hU : 𝒰.Bounded r) →
          (Y : PN.R) →
            Φhat.obj (CategoryTheory.MonoidalCategoryStruct.tensorObj (PN.ι.obj (PN.perm 𝒰 hU)) Y) ≅
              CategoryTheory.MonoidalCategoryStruct.tensorObj (J.obj (Pn.ι.obj (Pn.perm 𝒰 hU))) (Φhat.obj Y))
    (κ_nat :
      ∀ {𝒰 : DegreeProfilesReview.Uniform.BasisSystem} (hU : 𝒰.Bounded r) {Y Y' : PN.R} (f : Y ⟶ Y'),
        CategoryTheory.CategoryStruct.comp
            (Φhat.map (CategoryTheory.MonoidalCategoryStruct.whiskerLeft (PN.ι.obj (PN.perm 𝒰 hU)) f)) (κ hU Y').hom =
          CategoryTheory.CategoryStruct.comp (κ hU Y).hom
            (CategoryTheory.MonoidalCategoryStruct.whiskerLeft (J.obj (Pn.ι.obj (Pn.perm 𝒰 hU))) (Φhat.map f)))
    (δ_prod :
      ∀ {𝒰 𝒱 : DegreeProfilesReview.Uniform.BasisSystem} (hU : 𝒰.Bounded r) (hV : 𝒱.Bounded r)
        (hUV : (𝒰.prod 𝒱).Bounded r),
        CategoryTheory.CategoryStruct.comp (Φhat.map (PN.prodIso hU hV hUV).hom)
            (CategoryTheory.CategoryStruct.comp (γ.hom.app (PN.perm (𝒰.prod 𝒱) hUV))
              (J.map (Pn.ι.map (δ (𝒰.prod 𝒱) hUV).hom))) =
          CategoryTheory.CategoryStruct.comp (κ hU (PN.ι.obj (PN.perm 𝒱 hV))).hom
            (CategoryTheory.CategoryStruct.comp
              (CategoryTheory.MonoidalCategoryStruct.whiskerLeft (J.obj (Pn.ι.obj (Pn.perm 𝒰 hU)))
                (CategoryTheory.CategoryStruct.comp (γ.hom.app (PN.perm 𝒱 hV)) (J.map (Pn.ι.map (δ 𝒱 hV).hom))))
              (CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Functor.LaxMonoidal.μ J (Pn.ι.obj (Pn.perm 𝒰 hU)) (Pn.ι.obj (Pn.perm 𝒱 hV)))
                (J.map (Pn.prodIso hU hV hUV).hom)))) :
    DegreeProfilesReview.Deletion.M5w PN Pn Φ
def ClaudeC017.ChainBound : (R : Type) → [Field R] → DegreeProfilesReview.Uniform.BasisSystem → Prop :=
fun R [Field R] 𝒰 =>
  ∀ (t : ℕ),
    ∃ L,
      ∀ (n : ℕ) (W : Fin (L + 2) → Submodule R (MvPolynomial (𝒰.Rk n) R)),
        (∀ (i : Fin (L + 2)), W i ≤ MvPolynomial.restrictTotalDegree (𝒰.Rk n) R t) →
          (∀ (i : Fin (L + 2)) (g : ↥(DegreeProfilesReview.SymRep.Sfin n)),
              ∀ f ∈ W i, (MvPolynomial.rename fun v => g • v) f ∈ W i) →
            ¬StrictMono W
LinearFinal.linear_classification : ∀ (p : ℕ) [Fact (Nat.Prime p)] {R : Type} [inst : Field R] [CharP R p]
  (T : DegreeProfilesReview.Uniform.Template R),
  ∀ h ∈ {T.pcProfile, T.nsProfile},
    DegreeProfilesReview.Profiles.PeriodicProfile h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0)
        (DegreeProfilesReview.Profiles.period p T.k T.s) ∧
      (DegreeProfilesReview.Profiles.IsT1 h ∧
            ¬DegreeProfilesReview.Profiles.IsT2 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) ∧
              ¬DegreeProfilesReview.Profiles.IsT3 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) ∧
                ¬DegreeProfilesReview.Profiles.IsT4 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) ∨
          ¬DegreeProfilesReview.Profiles.IsT1 h ∧
              DegreeProfilesReview.Profiles.IsT2 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) ∧
                ¬DegreeProfilesReview.Profiles.IsT3 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) ∧
                  ¬DegreeProfilesReview.Profiles.IsT4 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) ∨
            ¬DegreeProfilesReview.Profiles.IsT1 h ∧
                ¬DegreeProfilesReview.Profiles.IsT2 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) ∧
                  DegreeProfilesReview.Profiles.IsT3 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) ∧
                    ¬DegreeProfilesReview.Profiles.IsT4 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) ∨
              ¬DegreeProfilesReview.Profiles.IsT1 h ∧
                ¬DegreeProfilesReview.Profiles.IsT2 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) ∧
                  ¬DegreeProfilesReview.Profiles.IsT3 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) ∧
                    DegreeProfilesReview.Profiles.IsT4 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0)) ∧
        (DegreeProfilesReview.Profiles.IsT2 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) →
            ∀ (n x : ℕ), T.n0 ≤ n → h n = ↑x → (↑n - 2 * ↑T.s - 1) / (2 * ↑T.k) < ↑x) ∧
          (DegreeProfilesReview.Profiles.IsT3 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) →
              ∃ D U,
                U.Nonempty ∧
                  (∃ c < DegreeProfilesReview.Profiles.period p T.k T.s D, c ∉ U) ∧
                    ∀ (n : ℕ),
                      DegreeProfilesReview.Profiles.onset T.k T.s T.n0 D ≤ n →
                        2 * T.k + 2 * T.s + 1 ≤ n →
                          n % DegreeProfilesReview.Profiles.period p T.k T.s D ∉ U →
                            ↑((n - 2 * T.s - 1) / (2 * T.k)) < h n) ∧
            (DegreeProfilesReview.Profiles.IsT4 h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) →
              ∀ (B : ℕ),
                ∃ n d,
                  B ≤ n ∧
                    B ≤ d ∧
                      d ∈ DegreeProfilesReview.Profiles.E h (DegreeProfilesReview.Profiles.onset T.k T.s T.n0) ∧
                        h n = ↑d ∧ n ≤ (p + 2) * (T.k * d + T.s) ∧ ↑n / ((↑p + 2) * ↑T.k) - ↑T.s / ↑T.k ≤ ↑d)
LinearFinal.exactness_linear : ∀ (p : ℕ) [inst : Fact (Nat.Prime p)] (L : Type) [inst_1 : Field L] [IsAlgClosed L]
  [inst_3 : CharP L p], ClaudeLinear.ExactnessHypothesis p L fun r => 2 * r - 1
LinearFinal.topWitnessHypothesis_linear : ∀ (p : ℕ) [inst : Fact (Nat.Prime p)] (L : Type) [inst_1 : Field L]
  [IsAlgClosed L] [inst_3 : CharP L p], ClaudeCP.TopWitnessHypothesis p L fun r => 2 * r - 1
@SelfContainedCycle004.canonicalM5w : {K : Type} →
  [inst : Field K] →
    {p a n r : ℕ} →
      [inst_1 : Fact (Nat.Prime p)] →
        [inst_2 : CharP K p] →
          {c : Fin a → K} →
            DegreeProfilesReview.Shifted.Generic p c →
              r < p ^ a →
                DegreeProfilesReview.Deletion.M5w (SelfContainedCycle003.canonicalSchurClass K r (n + p ^ a)).toM4
                  (SelfContainedCycle003.canonicalSchurClass K r n).toM4
                  (DegreeProfilesReview.ShiftedM5.Ψ (SelfContainedCycle003.canonicalSchurClass K r (n + p ^ a))
                    (SelfContainedCycle003.canonicalSchurClass K r n) ⋯)
@DegreeProfilesReview.FieldDescent.pcDegree_map : ∀ {σ : Type u_1} {K : Type u_2} {L : Type u_3} [inst : Field K]
  [inst_1 : Field L] [inst_2 : Algebra K L] (Γ : Set (MvPolynomial σ K)),
  DegreeProfilesReview.PC.pcDegree (DegreeProfilesReview.FieldDescent.mapSet L Γ) = DegreeProfilesReview.PC.pcDegree Γ
@DegreeProfilesReview.FieldDescent.nsDegree_map : ∀ {σ : Type u_1} {K : Type u_2} {L : Type u_3} [inst : Field K]
  [inst_1 : Field L] [inst_2 : Algebra K L] (Γ : Set (MvPolynomial σ K)),
  DegreeProfilesReview.NS.nsDegree (DegreeProfilesReview.FieldDescent.mapSet L Γ) = DegreeProfilesReview.NS.nsDegree Γ
@DegreeProfilesReview.Uniform.Template.pcProfile_le_nsProfile : ∀ {R : Type} [inst : Field R]
  (T : DegreeProfilesReview.Uniform.Template R) (n : ℕ), T.pcProfile n ≤ T.nsProfile n
@DegreeProfilesReview.Profiles.period_le : ∀ {p k : ℕ} (s : ℕ),
  2 ≤ p → 1 ≤ k → ∀ {d : ℕ}, 1 ≤ d → DegreeProfilesReview.Profiles.period p k s d ≤ p * (k * d + s)
@DegreeProfilesReview.Profiles.PeriodicProfile.exactly_one : ∀ {h : ℕ → ℕ∞} {N Q : ℕ → ℕ},
  DegreeProfilesReview.Profiles.PeriodicProfile h N Q →
    DegreeProfilesReview.Profiles.IsT1 h ∧
        ¬DegreeProfilesReview.Profiles.IsT2 h N ∧
          ¬DegreeProfilesReview.Profiles.IsT3 h N ∧ ¬DegreeProfilesReview.Profiles.IsT4 h N ∨
      ¬DegreeProfilesReview.Profiles.IsT1 h ∧
          DegreeProfilesReview.Profiles.IsT2 h N ∧
            ¬DegreeProfilesReview.Profiles.IsT3 h N ∧ ¬DegreeProfilesReview.Profiles.IsT4 h N ∨
        ¬DegreeProfilesReview.Profiles.IsT1 h ∧
            ¬DegreeProfilesReview.Profiles.IsT2 h N ∧
              DegreeProfilesReview.Profiles.IsT3 h N ∧ ¬DegreeProfilesReview.Profiles.IsT4 h N ∨
          ¬DegreeProfilesReview.Profiles.IsT1 h ∧
            ¬DegreeProfilesReview.Profiles.IsT2 h N ∧
              ¬DegreeProfilesReview.Profiles.IsT3 h N ∧ DegreeProfilesReview.Profiles.IsT4 h N
@DegreeProfilesReview.Profiles.PeriodicProfile.T3_structure : ∀ {h : ℕ → ℕ∞} {N Q : ℕ → ℕ},
  DegreeProfilesReview.Profiles.PeriodicProfile h N Q →
    DegreeProfilesReview.Profiles.IsT3 h N →
      ∃ D ∈ DegreeProfilesReview.Profiles.E h N,
        (∀ d ∈ DegreeProfilesReview.Profiles.E h N, d ≤ D) ∧
          ∃ U,
            (∀ c ∈ U, c < Q D) ∧
              U.Nonempty ∧
                (∃ c < Q D, c ∉ U) ∧
                  (∀ (n : ℕ), N D ≤ n → n % Q D ∈ U → ∃ v ≤ D, ∀ (m : ℕ), N D ≤ m → m % Q D = n % Q D → h m = ↑v) ∧
                    ∀ (n : ℕ), N D ≤ n → n % Q D ∉ U → ∀ (d : ℕ), N d ≤ n → ↑d < h n
@ClaudeCP.liminf_eq_min : ∀ {h : ℕ → ℕ∞} {N Q : ℕ → ℕ},
  DegreeProfilesReview.Profiles.PeriodicProfile h N Q →
    (DegreeProfilesReview.Profiles.E h N).Nonempty →
      ∃ e₀ ∈ DegreeProfilesReview.Profiles.E h N,
        (∀ x ∈ DegreeProfilesReview.Profiles.E h N, e₀ ≤ x) ∧ Filter.liminf h Filter.atTop = ↑e₀
@ClaudeCP.liminf_eq_top : ∀ {h : ℕ → ℕ∞} {N Q : ℕ → ℕ},
  DegreeProfilesReview.Profiles.PeriodicProfile h N Q →
    DegreeProfilesReview.Profiles.IsT2 h N → Filter.liminf h Filter.atTop = ⊤
@SelfContainedCycle084.topProjector_annihilates : ∀ {F : Type u_1} {V : Type u_2} [inst : Field F]
  [inst_1 : AddCommGroup V] [inst_2 : Module F V] (z w : Module.End F V) {m : ℕ},
  1 ≤ m →
    SelfContainedCycle084.PureTop z m →
      z ^ m * w * z ^ m = z ^ m →
        z ^ (m + 1) = 0 →
          z * SelfContainedCycle084.topProjector z w m = 0 ∧ SelfContainedCycle084.topProjector z w m * z = 0
@SelfContainedCycle084.topProjector_idempotent : ∀ {F : Type u_1} {V : Type u_2} [inst : Field F]
  [inst_1 : AddCommGroup V] [inst_2 : Module F V] (z w : Module.End F V) {m : ℕ},
  1 ≤ m →
    SelfContainedCycle084.PureTop z m →
      z ^ m * w * z ^ m = z ^ m →
        z ^ (m + 1) = 0 →
          SelfContainedCycle084.topProjector z w m * SelfContainedCycle084.topProjector z w m =
            SelfContainedCycle084.topProjector z w m
'LinearFinal.linear_classification' depends on axioms: [propext, Classical.choice, Quot.sound]
'LinearFinal.exactness_linear' depends on axioms: [propext, Classical.choice, Quot.sound]
'SelfContainedCycle004.canonicalM5w' depends on axioms: [propext, Classical.choice, Quot.sound]
'DegreeProfilesReview.FieldDescent.pcDegree_map' depends on axioms: [propext, Classical.choice, Quot.sound]
'DegreeProfilesReview.FieldDescent.nsDegree_map' depends on axioms: [propext, Classical.choice, Quot.sound]
'ClaudeCP.liminf_eq_min' depends on axioms: [propext, Classical.choice, Quot.sound]
ClaudeComparison.comparison : ∀ (p : ℕ) [Fact (Nat.Prime p)] {R : Type} [inst : Field R] [CharP R p]
  (T : DegreeProfilesReview.Uniform.Template R),
  ∃ F,
    Monotone F ∧
      ∀ (n t : ℕ), DegreeProfilesReview.PC.Refutes (T.inst n) t → DegreeProfilesReview.NS.NSRefutes (T.inst n) (F t)
ClaudeComparison.upperComparison : ∀ (p : ℕ) [Fact (Nat.Prime p)] {R : Type} [inst : Field R] [CharP R p]
  (T : DegreeProfilesReview.Uniform.Template R),
  ∃ F, Monotone F ∧ DegreeProfilesReview.Profiles.UpperComparison F T.pcProfile T.nsProfile
ClaudeComparison.types_agree_linear : ∀ (p : ℕ) [Fact (Nat.Prime p)] {R : Type} [inst : Field R] [CharP R p]
  (T : DegreeProfilesReview.Uniform.Template R),
  have N := DegreeProfilesReview.Profiles.onset T.k T.s T.n0;
  (DegreeProfilesReview.Profiles.IsT1 T.pcProfile ↔ DegreeProfilesReview.Profiles.IsT1 T.nsProfile) ∧
    (DegreeProfilesReview.Profiles.IsT2 T.pcProfile N ↔ DegreeProfilesReview.Profiles.IsT2 T.nsProfile N) ∧
      (DegreeProfilesReview.Profiles.IsT3 T.pcProfile N ↔ DegreeProfilesReview.Profiles.IsT3 T.nsProfile N) ∧
        (DegreeProfilesReview.Profiles.IsT4 T.pcProfile N ↔ DegreeProfilesReview.Profiles.IsT4 T.nsProfile N)
ClaudeComparison.common_type_linear : ∀ (p : ℕ) [Fact (Nat.Prime p)] {R : Type} [inst : Field R] [CharP R p]
  (T : DegreeProfilesReview.Uniform.Template R),
  have N := DegreeProfilesReview.Profiles.onset T.k T.s T.n0;
  DegreeProfilesReview.Profiles.IsT1 T.pcProfile ∧ DegreeProfilesReview.Profiles.IsT1 T.nsProfile ∨
    DegreeProfilesReview.Profiles.IsT2 T.pcProfile N ∧ DegreeProfilesReview.Profiles.IsT2 T.nsProfile N ∨
      DegreeProfilesReview.Profiles.IsT3 T.pcProfile N ∧ DegreeProfilesReview.Profiles.IsT3 T.nsProfile N ∨
        DegreeProfilesReview.Profiles.IsT4 T.pcProfile N ∧ DegreeProfilesReview.Profiles.IsT4 T.nsProfile N
@ClaudeComparison.detect : ∀ {p : ℕ} [inst : Fact (Nat.Prime p)] {K : Type} [inst_1 : Field K] [inst_2 : CharP K p]
  {a n : ℕ} {c : Fin a → K} {s : ℕ} {w : MonoidAlgebra K ↥(DegreeProfilesReview.SymRep.Sfin (n + p ^ a))},
  DegreeProfilesReview.Shifted.Generic p c →
    s < p ^ a →
      ClaudeCP.IsTopWitness p s a n c w →
        ∀ {𝒰 : DegreeProfilesReview.Uniform.BasisSystem} {r : ℕ},
          𝒰.Bounded r →
            r + r ≤ s →
              ∀ {S S' : Submodule K (𝒰.Rk (n + p ^ a) →₀ K)},
                ClaudeComparison.IsInv (DegreeProfilesReview.SymRep.permRep K 𝒰 (n + p ^ a)).ρ S →
                  ClaudeComparison.IsInv (DegreeProfilesReview.SymRep.permRep K 𝒰 (n + p ^ a)).ρ S' →
                    (∀ x ∈ S', (ClaudeCP.topProj c w (DegreeProfilesReview.SymRep.permRep K 𝒰 (n + p ^ a))) x ∈ S) →
                      S' ≤ S
@ClaudeComparison.delImg_strict : ∀ {p : ℕ} [inst : Fact (Nat.Prime p)] {K : Type} [inst_1 : Field K]
  [inst_2 : CharP K p] {a n : ℕ} {c : Fin a → K} {𝒰 : DegreeProfilesReview.Uniform.BasisSystem} {r : ℕ}
  (hc : DegreeProfilesReview.Shifted.Generic p c) (hrq : r < p ^ a) (hU : 𝒰.Bounded r) {s : ℕ},
  s < p ^ a →
    ∀ {w : MonoidAlgebra K ↥(DegreeProfilesReview.SymRep.Sfin (n + p ^ a))},
      ClaudeCP.IsTopWitness p s a n c w →
        r + r ≤ s →
          ∀ {S S' : Submodule K (𝒰.Rk (n + p ^ a) →₀ K)}
            (hS : ClaudeComparison.IsInv (DegreeProfilesReview.SymRep.permRep K 𝒰 (n + p ^ a)).ρ S)
            (hS' : ClaudeComparison.IsInv (DegreeProfilesReview.SymRep.permRep K 𝒰 (n + p ^ a)).ρ S'),
            S < S' → ClaudeComparison.delImg hc hrq hU S hS < ClaudeComparison.delImg hc hrq hU S' hS'
ClaudeComparison.chainBoundPerm : ∀ (p : ℕ) [Fact (Nat.Prime p)] (K : Type) [inst : Field K] [IsAlgClosed K] [CharP K p]
  (𝒰 : DegreeProfilesReview.Uniform.BasisSystem) {r : ℕ},
  𝒰.Bounded r →
    ∃ L,
      ∀ (N : ℕ) (W : Fin (L + 2) → Submodule K (𝒰.Rk N →₀ K)),
        (∀ (i : Fin (L + 2)), ClaudeComparison.IsInv (DegreeProfilesReview.SymRep.permRep K 𝒰 N).ρ (W i)) →
          ¬StrictMono W
'ClaudeComparison.comparison' depends on axioms: [propext, Classical.choice, Quot.sound]
'ClaudeComparison.types_agree_linear' depends on axioms: [propext, Classical.choice, Quot.sound]
'ClaudeComparison.common_type_linear' depends on axioms: [propext, Classical.choice, Quot.sound]
'ClaudeComparison.detect' depends on axioms: [propext, Classical.choice, Quot.sound]
@SelfContainedCycle058.no_PCRefutes_rectangle : ∀ {F : Type u_1} [inst : Field F] {p a n m D : ℕ},
  Nat.Prime p →
    ∀ [CharP F p],
      1 ≤ n →
