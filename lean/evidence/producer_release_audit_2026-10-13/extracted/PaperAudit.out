@DegreeProfilesReview.Shifted.mem_range_pow_of_degreeData : ∀ {K : Type u_1} [inst : Field K] {Γ : Type u_2}
  [inst_1 : Group Γ] {ι : Type u_3} [inst_2 : Fintype ι] {s : ι → Γ} (c : ι → K) {X : Type u_4} [inst_3 : MulAction Γ X]
  {Y : Type u_5} [inst_4 : AddCommGroup Y] [inst_5 : Module K Y] (σ : Representation K Γ Y)
