  [inst_2 : CategoryTheory.Abelian BN] [inst_3 : CategoryTheory.Category.{0, 1} Bn] [inst_4 : CategoryTheory.Abelian Bn]
  {PN : DegreeProfilesReview.Deletion.M4 K (T.k * d + T.s) N BN}
