  (m : DegreeProfilesReview.Uniform.InvMatrix K 𝒰 𝒱),
  CategoryTheory.CategoryStruct.comp
      ((DegreeProfilesReview.ShiftedM5.Ψhat p a n c).map (DegreeProfilesReview.SymRep.matHom m (n + p ^ a)))
      (DegreeProfilesReview.ShiftedM5.δ' hc hrq hV).hom =
    CategoryTheory.CategoryStruct.comp (DegreeProfilesReview.ShiftedM5.δ' hc hrq hU).hom
      (DegreeProfilesReview.SymRep.matHom m n)
@DegreeProfilesReview.ShiftedM5.κ' : {p a n : ℕ} →
  [inst : Fact (Nat.Prime p)] →
    {K : Type} →
      [inst_1 : Field K] →
        {c : Fin a → K} →
          [inst_2 : CharP K p] →
            DegreeProfilesReview.Shifted.Generic p c →
              {r : ℕ} →
                r < p ^ a →
                  {𝒰 : DegreeProfilesReview.Uniform.BasisSystem} →
                    𝒰.Bounded r →
                      (Y : Rep K ↥(DegreeProfilesReview.SymRep.Sfin (n + p ^ a))) →
                        (DegreeProfilesReview.ShiftedM5.Ψhat p a n c).obj
                            (CategoryTheory.MonoidalCategoryStruct.tensorObj
                              (DegreeProfilesReview.SymRep.permRep K 𝒰 (n + p ^ a)) Y) ≅
                          CategoryTheory.MonoidalCategoryStruct.tensorObj (DegreeProfilesReview.SymRep.permRep K 𝒰 n)
                            ((DegreeProfilesReview.ShiftedM5.Ψhat p a n c).obj Y)
@DegreeProfilesReview.ShiftedM5.δ'_prod : ∀ {p a n : ℕ} [inst : Fact (Nat.Prime p)] {K : Type} [inst_1 : Field K]
  {c : Fin a → K} [inst_2 : CharP K p] (hc : DegreeProfilesReview.Shifted.Generic p c) {r : ℕ} (hrq : r < p ^ a)
  {𝒰 𝒱 : DegreeProfilesReview.Uniform.BasisSystem} (hU : 𝒰.Bounded r) (hV : 𝒱.Bounded r) (hUV : (𝒰.prod 𝒱).Bounded r),
  CategoryTheory.CategoryStruct.comp
      ((DegreeProfilesReview.ShiftedM5.Ψhat p a n c).map (DegreeProfilesReview.SymRep.permProdIso 𝒰 𝒱 (n + p ^ a)).hom)
      (DegreeProfilesReview.ShiftedM5.δ' hc hrq hUV).hom =
    CategoryTheory.CategoryStruct.comp
      (DegreeProfilesReview.ShiftedM5.κ' hc hrq hU (DegreeProfilesReview.SymRep.permRep K 𝒱 (n + p ^ a))).hom
      (CategoryTheory.CategoryStruct.comp
        (CategoryTheory.MonoidalCategoryStruct.whiskerLeft (DegreeProfilesReview.SymRep.permRep K 𝒰 n)
          (DegreeProfilesReview.ShiftedM5.δ' hc hrq hV).hom)
        (DegreeProfilesReview.SymRep.permProdIso 𝒰 𝒱 n).hom)
@SelfContainedCycle084.topProjector_on_kernel : ∀ {F : Type u_1} {V : Type u_2} [inst : Field F]
  [inst_1 : AddCommGroup V] [inst_2 : Module F V] (z w : Module.End F V) (m : ℕ) {v : V},
  z v = 0 → (SelfContainedCycle084.topProjector z w m) v = v - (z ^ m) (w v)
@SelfContainedCycle084.kernel_residual_in_range : ∀ {F : Type u_1} {V : Type u_2} [inst : Field F]
  [inst_1 : AddCommGroup V] [inst_2 : Module F V] (z w : Module.End F V) {m : ℕ},
  1 ≤ m → ∀ {v : V}, z v = 0 → v - (SelfContainedCycle084.topProjector z w m) v ∈ LinearMap.range z
@ClaudeDCP.zb_Frk : ∀ {K : Type} [inst : Field K] {b N : ℕ}
  (φ : Module.End K ↑(DegreeProfilesReview.SymRep.permRep K (DegreeProfilesReview.ConcreteM4.injTuples b) N).V),
  (∀ (v : ↑(DegreeProfilesReview.SymRep.permRep K (DegreeProfilesReview.ConcreteM4.injTuples b) N).V),
      φ v ∈ BExact.SocV K b N) →
    (∀ v ∈ BExact.VpV K b N, φ v = 0) →
      (∀ g ∈ BExact.GV K b N, g * φ = φ * g) → ClaudeDCP.ZB Finset.univ Finset.univ b (ClaudeDCP.Frk φ)
@ClaudeDCP.sum_row_realFn : ∀ {α : Type u_1} [inst : Fintype α] [inst_1 : DecidableEq α] {K : Type u_2}
  [inst_2 : CommRing K] {R C : Finset α} {c : Equiv.Perm α → K},
  ClaudeDCP.FitsAll R C c →
    ∀ {ρ : Finset (α × α)} {x : α},
      x ∈ R →
        x ∉ ClaudeDCP.rowsOf ρ →
          ∑ y ∈ C \ ClaudeDCP.colsOf ρ, ClaudeDCP.realFn c (insert (x, y) ρ) = ClaudeDCP.realFn c ρ
@ClaudeDCP.zb_realFn : ∀ {α : Type u_1} [inst : Fintype α] [inst_1 : DecidableEq α] {K : Type u_2} [inst_2 : CommRing K]
  {R C : Finset α} {c : Equiv.Perm α → K},
  ClaudeDCP.FitsAll R C c →
    ∀ {b : ℕ},
      (∀ (ρ : Finset (α × α)), ClaudeDCP.OnBoard R C ρ → ρ.card + 1 = b → ClaudeDCP.realFn c ρ = 0) →
        ClaudeDCP.ZB R C b (ClaudeDCP.realFn c)
@RForce.zb_contract : ∀ {α : Type u_1} [Fintype α] [inst : DecidableEq α] [LinearOrder α] {K : Type u_2}
  [inst_2 : CommRing K] {R C : Finset α} {k : ℕ} {F : Finset (α × α) → K},
  ClaudeDCP.ZB R C (k + 1) F →
    ∀ {x0 y0 : α}, x0 ∈ R → y0 ∈ C → ClaudeDCP.ZB (R.erase x0) (C.erase y0) k fun σ => F (insert (x0, y0) σ)
@RForce.lexFirst_of_corner : ∀ {α : Type u_1} [inst : Fintype α] [inst_1 : DecidableEq α] [inst_2 : LinearOrder α]
  {w v : Equiv.Perm α} {C : Finset α} {y0 : α},
  (∀ y ∈ C, y ≠ y0 → w y = v y) →
    RForce.lisOn w C = RForce.lisOn v (C.erase y0) →
      (∀ B ∈ RForce.maxChains w C, y0 ∈ B → RForce.LexLt (RForce.lexFirst v (C.erase y0)) B) →
        RForce.lexFirst w C = RForce.lexFirst v (C.erase y0)
