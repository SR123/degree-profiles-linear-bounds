@DegreeProfilesReview.ShiftedM5.δ'_mat : ∀ {p a n : ℕ} [inst : Fact (Nat.Prime p)] {K : Type} [inst_1 : Field K]
  {c : Fin a → K} [inst_2 : CharP K p] (hc : DegreeProfilesReview.Shifted.Generic p c) {r : ℕ} (hrq : r < p ^ a)
