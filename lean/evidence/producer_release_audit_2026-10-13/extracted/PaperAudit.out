@BExact.lemmaD : ∀ {R : Type} [inst : CommRing R] {ι : Type} [Fintype ι] [inst_2 : DecidableEq ι] {α : Type}
  [inst_3 : Fintype α] [inst_4 : DecidableEq α] (S : Finset ι) (L : Finset α),
