switch_i : ∀ (P : Prog), ¬P.Halts → ∀ {n : ℕ}, 0 < n → HasModelOfSize (theta P) n
no_large_model : ∀ (P : Prog) {T : ℕ},
  P.IsHaltSt (P.cfg T).1 →
    (∀ j < T, ¬P.IsHaltSt (P.cfg j).1) →
      ∀ {U : Type} (M : Str U), IsModel (theta P) M → ∀ (d : Fin (T + 1) → U), Function.Injective d → False
no_model_of_size : ∀ (P : Prog) {T : ℕ},
  P.IsHaltSt (P.cfg T).1 → (∀ j < T, ¬P.IsHaltSt (P.cfg j).1) → ∀ {n : ℕ}, T + 1 ≤ n → ¬HasModelOfSize (theta P) n
theta_nsRefutes : ∀ (P : Prog) (K : Type) [inst : Field K] {T : ℕ},
  P.IsHaltSt (P.cfg T).1 →
    (∀ j < T, ¬P.IsHaltSt (P.cfg j).1) →
      ∀ {n : ℕ}, T + 1 ≤ n → DegreeProfilesReview.NS.NSRefutes ((template (theta P) K).inst n) (haltBound P T)
theta_eventually_bounded : ∀ (P : Prog) (K : Type) [inst : Field K],
  P.Halts → ∃ C N, ∀ (n : ℕ), N ≤ n → DegreeProfilesReview.NS.nsDegree ((template (theta P) K).inst n) ≤ ↑C
@primrec_compiles : ∀ {n : ℕ} {f : List.Vector ℕ n → ℕ},
  Nat.Primrec' f →
    ∀ (ins : Fin n → ℕ) (o b : ℕ), (∀ (i : Fin n), ins i < b) → o < b → ∃ code len, Computes f ins o b code len
univProg_halts_iff : ∀ (m : ℕ), (univProg m).Halts ↔ ∃ k, hfun k m = 0
eval_dom_iff_halts : ∀ (c : Nat.Partrec.Code), (c.eval 0).Dom ↔ (univProg (Encodable.encode c)).Halts
theta_primrec : Primrec theta
univProg_primrec : Primrec univProg
conj_primrec : ∀ (ψ : Sentence), Primrec (conj ψ)
red_primrec : ∀ (p τ : ℕ), Primrec (red p τ)
red_promised : ∀ (p τ : ℕ) (c : Nat.Partrec.Code), Promised (red p τ c)
conj_type_halt : ∀ (K : Type) [inst : Field K] (ψ : Sentence) (P : Prog),
  P.Halts → NSType (template (conj ψ (theta P)) K) 1
conj_type_nonhalt : ∀ (p : ℕ) [hp : Fact (Nat.Prime p)] (K : Type) [inst : Field K] [CharP K p] (ψ : Sentence),
  WF ψ → ∀ (P : Prog), ¬P.Halts → ∀ (τ : ℕ), NSType (template (conj ψ (theta P)) K) τ ↔ NSType (template ψ K) τ
nsDegree_conj_eq_left : ∀ (φ ψ : Sentence) (n : ℕ) (K : Type) [inst : Field K],
  WF φ →
    WF ψ →
      ∀ (y : (VarSys ψ).Rk n → K),
        (∀ g ∈ (template ψ K).inst n, (MvPolynomial.eval y) g = 0) →
          DegreeProfilesReview.NS.nsDegree ((template (conj φ ψ) K).inst n) =
            DegreeProfilesReview.NS.nsDegree ((template φ K).inst n)
hasRoot_iff : ∀ (φ : Sentence) (K : Type) [inst : Field K] {n : ℕ},
  0 < n → ((∃ x, ∀ f ∈ (template φ K).inst n, (MvPolynomial.eval x) f = 0) ↔ HasModelOfSize φ n)
