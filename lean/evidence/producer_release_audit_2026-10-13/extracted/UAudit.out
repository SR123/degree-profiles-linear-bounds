pcDegree_conj_eq_left : ∀ (φ ψ : Sentence) (n : ℕ) (K : Type) [inst : Field K],
  WF φ →
    WF ψ →
      ∀ (y : (VarSys ψ).Rk n → K),
        (∀ g ∈ (template ψ K).inst n, (MvPolynomial.eval y) g = 0) →
          DegreeProfilesReview.PC.pcDegree ((template (conj φ ψ) K).inst n) =
            DegreeProfilesReview.PC.pcDegree ((template φ K).inst n)
wit_pc_type : ∀ (p : ℕ) [hp : Fact (Nat.Prime p)] (K : Type) [inst : Field K] [CharP K p],
  ∀ τ ∈ {1, 2, 3, 4}, PCType (template (wit p τ) K) τ
red2_pc_halt : ∀ (K : Type) [inst : Field K] (p : ℕ) [hp : Fact (Nat.Prime p)] [CharP K p] (a b : ℕ),
  a ∈ {1, 2, 3, 4} → ∀ (c : Nat.Partrec.Code), (c.eval 0).Dom → PCType (template (red2 p a b c) K) a
red2_pc_nonhalt : ∀ (K : Type) [inst : Field K] (p : ℕ) [hp : Fact (Nat.Prime p)] [CharP K p] (a b : ℕ),
  a ∈ {1, 2, 3, 4} →
    b ∈ {1, 2, 3, 4} →
      wrank a < wrank b → ∀ (c : Nat.Partrec.Code), ¬(c.eval 0).Dom → PCType (template (red2 p a b c) K) b
bhat_refutes_B : ∀ (K : Type) [inst : Field K] {n d : ℕ},
  0 < n →
    DegreeProfilesReview.PC.Refutes ((template bhat K).inst n) d →
      DegreeProfilesReview.PC.Refutes {f | SelfContainedCycle054.IsBAxiom n (2 * n) f} d
eta_pc_lower : ∀ (p : ℕ) [hp : Fact (Nat.Prime p)] (K : Type) [inst : Field K] [CharP K p] {n d : ℕ},
  3 ≤ n → DegreeProfilesReview.PC.Refutes ((template eta K).inst n) d → n < 3 * p * d
