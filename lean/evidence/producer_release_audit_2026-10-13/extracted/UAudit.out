nsDegree_join_ge : ∀ (A B : Sentence) (K : Type) [inst : Field K] (n : ℕ),
  WF A →
    WF B →
      0 < n →
        max (DegreeProfilesReview.NS.nsDegree ((template A K).inst n))
            (DegreeProfilesReview.NS.nsDegree ((template B K).inst n)) ≤
          DegreeProfilesReview.NS.nsDegree ((template (join A B) K).inst n)
