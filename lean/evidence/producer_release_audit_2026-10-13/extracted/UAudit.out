    (∀ (n : ℕ), 1 ≤ n → max (h n) (g n) ≤ h' n) →
      (∀ (n : ℕ), 1 ≤ n → h' n ≤ max (h n) (g n) + 1) → ∀ (τ : ℕ), IType h' τ ↔ IType h τ
