  ∀ A ⊆ {1, 2, 3, 4},
    A.Nonempty →
      (∃ τ ∈ {1, 2, 3, 4}, τ ∉ A) →
        ¬∃ D, Partrec D ∧ ∀ (φ : Sentence), Promised φ → ∃ b ∈ D φ, b = true ↔ ∃ τ ∈ A, NSType (template φ K) τ
