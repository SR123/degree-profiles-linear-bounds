join_no_model : ∀ (A B : Sentence) (n : ℕ),
  WF A → WF B → 0 < n → HasModelOfSize (join A B) n → HasModelOfSize A n ∨ HasModelOfSize B n
join_WF : ∀ (A B : Sentence), WF A → WF B → WF (join A B)
join_primrec : ∀ (A : Sentence), Primrec (join A)
templateParams_primrec : Primrec fun φ => (maxVArity φ, axSupp φ, degD φ, maxVArity φ * degD φ + axSupp φ + 1)
join_cases : ∀ (A B : Sentence) (K : Type) [inst : Field K] (n : ℕ),
  WF A →
    WF B →
      ∀ {g : MvPolynomial ((VarSys (join A B)).Rk n) K},
        g ∈ (template (join A B) K).inst n →
          (∃ f, IsStruct A K n f ∧ g = (MvPolynomial.rename (ιA A B n)) f) ∨
            (∃ f, IsStruct B K n f ∧ g = (MvPolynomial.rename (ιB A B n)) f) ∨
              (∃ t, g = MvPolynomial.X (zv A B n t) ^ 2 - MvPolynomial.X (zv A B n t)) ∨
                (∃ f ∈ (template A K).inst n,
                    ∃ t, g = MvPolynomial.X (zv A B n t) * (MvPolynomial.rename (ιA A B n)) f) ∨
                  ∃ f ∈ (template B K).inst n,
                    ∃ t, g = (1 - MvPolynomial.X (zv A B n t)) * (MvPolynomial.rename (ιB A B n)) f
