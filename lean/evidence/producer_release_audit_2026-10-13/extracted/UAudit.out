@[reducible] def ClaudeUndec.Sentence : Type :=
(List ℕ × List ℕ) × List Clause
def ClaudeUndec.IsModel : {α : Type} → Sentence → Str α → Prop :=
fun {α} φ M => ∀ c ∈ φ.clauses, ∀ (σ : ℕ → α), clauseHolds φ M σ c
def ClaudeUndec.HasModelOfSize : Sentence → ℕ → Prop :=
fun φ n => ∃ M, IsModel φ M
def ClaudeUndec.WF : Sentence → Prop :=
fun φ => ∀ c ∈ φ.clauses, ∀ l ∈ c, AtomWF φ l.2
def ClaudeUndec.Promised : Sentence → Prop :=
fun φ => WF φ ∧ ∀ (n : ℕ), 0 < n → ¬HasModelOfSize φ n
def ClaudeUndec.TypeSep : (Sentence → ℕ → Prop) → Set ℕ → Set ℕ → Prop :=
fun T A B =>
  ∃ D,
    Partrec D ∧
      (∀ (φ : Sentence), Promised φ → ∀ τ ∈ A, T φ τ → true ∈ D φ) ∧
        ∀ (φ : Sentence), Promised φ → ∀ τ ∈ B, T φ τ → false ∈ D φ
def Computable.{u_1, u_2} : {α : Type u_1} → {σ : Type u_2} → [Primcodable α] → [Primcodable σ] → (α → σ) → Prop :=
fun {α} {σ} [Primcodable α] [Primcodable σ] f => Partrec ↑f
def Partrec.{u_1, u_2} : {α : Type u_1} → {σ : Type u_2} → [Primcodable α] → [Primcodable σ] → (α →. σ) → Prop :=
fun {α} {σ} [Primcodable α] [Primcodable σ] f =>
  Nat.Partrec fun n => (↑(Encodable.decode n)).bind fun a => Part.map Encodable.encode (f a)
def ComputablePred.{u_1} : {α : Type u_1} → [Primcodable α] → (α → Prop) → Prop :=
fun {α} [Primcodable α] p => ∃ x, Computable fun a => decide (p a)
def ClaudeUndec.NSType : {K : Type} → [inst : Field K] → DegreeProfilesReview.Uniform.Template K → ℕ → Prop :=
fun {K} [Field K] T x =>
  match x with
  | 1 => DegreeProfilesReview.Profiles.IsT1 T.nsProfile
  | 2 => DegreeProfilesReview.Profiles.IsT2 T.nsProfile (DegreeProfilesReview.Profiles.onset T.k T.s T.n0)
  | 3 => DegreeProfilesReview.Profiles.IsT3 T.nsProfile (DegreeProfilesReview.Profiles.onset T.k T.s T.n0)
  | 4 => DegreeProfilesReview.Profiles.IsT4 T.nsProfile (DegreeProfilesReview.Profiles.onset T.k T.s T.n0)
  | x => False
def ClaudeUndec.PCType : {K : Type} → [inst : Field K] → DegreeProfilesReview.Uniform.Template K → ℕ → Prop :=
fun {K} [Field K] T x =>
  match x with
  | 1 => DegreeProfilesReview.Profiles.IsT1 T.pcProfile
  | 2 => DegreeProfilesReview.Profiles.IsT2 T.pcProfile (DegreeProfilesReview.Profiles.onset T.k T.s T.n0)
  | 3 => DegreeProfilesReview.Profiles.IsT3 T.pcProfile (DegreeProfilesReview.Profiles.onset T.k T.s T.n0)
  | 4 => DegreeProfilesReview.Profiles.IsT4 T.pcProfile (DegreeProfilesReview.Profiles.onset T.k T.s T.n0)
  | x => False
def ClaudeUndec.IType : (ℕ → ℕ∞) → ℕ → Prop :=
fun h x =>
  match x with
  | 1 => DegreeProfilesReview.Profiles.EventuallyBounded h
  | 2 => Rec h = ∅
  | 3 => (Rec h).Finite ∧ (Rec h).Nonempty ∧ ¬DegreeProfilesReview.Profiles.EventuallyBounded h
  | 4 => (Rec h).Infinite
  | x => False
def ClaudeUndec.Rec : (ℕ → ℕ∞) → Set ℕ :=
fun h => {d | ∀ (M : ℕ), ∃ n, M ≤ n ∧ h n = ↑d}
def DegreeProfilesReview.Profiles.IsT1 : (ℕ → ℕ∞) → Prop :=
fun h => DegreeProfilesReview.Profiles.EventuallyBounded h
def DegreeProfilesReview.Profiles.IsT2 : (ℕ → ℕ∞) → (ℕ → ℕ) → Prop :=
fun h N => DegreeProfilesReview.Profiles.E h N = ∅
def DegreeProfilesReview.Profiles.IsT3 : (ℕ → ℕ∞) → (ℕ → ℕ) → Prop :=
fun h N =>
  (DegreeProfilesReview.Profiles.E h N).Finite ∧
    (DegreeProfilesReview.Profiles.E h N).Nonempty ∧ ¬DegreeProfilesReview.Profiles.EventuallyBounded h
def DegreeProfilesReview.Profiles.IsT4 : (ℕ → ℕ∞) → (ℕ → ℕ) → Prop :=
fun h N => (DegreeProfilesReview.Profiles.E h N).Infinite
def DegreeProfilesReview.Profiles.E : (ℕ → ℕ∞) → (ℕ → ℕ) → Set ℕ :=
fun h N => {d | ∃ n, N d ≤ n ∧ h n = ↑d}
def DegreeProfilesReview.NS.NSRefutes.{u_1, u_2} : {σ : Type u_1} →
  {K : Type u_2} → [inst : Field K] → Set (MvPolynomial σ K) → ℕ → Prop :=
fun {σ} {K} [Field K] Γ d => ∃ s a, (∀ f ∈ s, f ∈ Γ) ∧ (∀ f ∈ s, (a f * f).totalDegree ≤ d) ∧ ∑ f ∈ s, a f * f = 1
def DegreeProfilesReview.NS.nsDegree.{u_1, u_2} : {σ : Type u_1} →
  {K : Type u_2} → [inst : Field K] → Set (MvPolynomial σ K) → ℕ∞ :=
fun {σ} {K} [Field K] Γ => if h : ∃ d, DegreeProfilesReview.NS.NSRefutes Γ d then ↑(Nat.find h) else ⊤
inductive DegreeProfilesReview.PC.IsProof.{u_1, u_2} : {σ : Type u_1} →
  {K : Type u_2} → [inst : Field K] → Set (MvPolynomial σ K) → List (MvPolynomial σ K) → Prop
number of parameters: 4
constructors:
DegreeProfilesReview.PC.IsProof.nil : ∀ {σ : Type u_1} {K : Type u_2} [inst : Field K] {Γ : Set (MvPolynomial σ K)},
  DegreeProfilesReview.PC.IsProof Γ []
DegreeProfilesReview.PC.IsProof.ax : ∀ {σ : Type u_1} {K : Type u_2} [inst : Field K] {Γ : Set (MvPolynomial σ K)}
  {l : List (MvPolynomial σ K)} {f : MvPolynomial σ K},
  DegreeProfilesReview.PC.IsProof Γ l → f ∈ Γ → DegreeProfilesReview.PC.IsProof Γ (f :: l)
DegreeProfilesReview.PC.IsProof.lin : ∀ {σ : Type u_1} {K : Type u_2} [inst : Field K] {Γ : Set (MvPolynomial σ K)}
  {l : List (MvPolynomial σ K)} {f : MvPolynomial σ K},
  DegreeProfilesReview.PC.IsProof Γ l → f ∈ Submodule.span K {g | g ∈ l} → DegreeProfilesReview.PC.IsProof Γ (f :: l)
DegreeProfilesReview.PC.IsProof.mulX : ∀ {σ : Type u_1} {K : Type u_2} [inst : Field K] {Γ : Set (MvPolynomial σ K)}
  {l : List (MvPolynomial σ K)} {g : MvPolynomial σ K} (i : σ),
  DegreeProfilesReview.PC.IsProof Γ l → g ∈ l → DegreeProfilesReview.PC.IsProof Γ (MvPolynomial.X i * g :: l)
def DegreeProfilesReview.PC.Refutes.{u_1, u_2} : {σ : Type u_1} →
  {K : Type u_2} → [inst : Field K] → Set (MvPolynomial σ K) → ℕ → Prop :=
fun {σ} {K} [Field K] Γ d => DegreeProfilesReview.PC.Derives Γ d 1
def DegreeProfilesReview.PC.pcDegree.{u_1, u_2} : {σ : Type u_1} →
  {K : Type u_2} → [inst : Field K] → Set (MvPolynomial σ K) → ℕ∞ :=
fun {σ} {K} [Field K] Γ => if h : ∃ d, DegreeProfilesReview.PC.Refutes Γ d then ↑(Nat.find h) else ⊤
def ClaudeUndec.join : Sentence → Sentence → Sentence :=
fun A B =>
  ((A.rels ++ B.rels ++ [1], A.funs ++ B.funs),
    List.map (guardN (A.rels.length + B.rels.length)) A.clauses ++
      List.map (guardP (A.rels.length + B.rels.length)) (List.map (Clause.shift A.rels.length A.funs.length) B.clauses))
def ClaudeUndec.guardN : ℕ → Clause → Clause :=
fun z c => (false, Atom.rel z [nvars c]) :: c
def ClaudeUndec.guardP : ℕ → Clause → Clause :=
fun z c => (true, Atom.rel z [nvars c]) :: c
def ClaudeUndec.conj : Sentence → Sentence → Sentence :=
fun φ ψ =>
  ((φ.rels ++ ψ.rels, φ.funs ++ ψ.funs), φ.clauses ++ List.map (Clause.shift φ.rels.length φ.funs.length) ψ.clauses)
def ClaudeUndec.wit : ℕ → ℕ → Sentence :=
fun p x =>
  match x with
  | 1 => psi1
  | 2 => eta
  | 3 => psi3 p
  | 4 => bhat
  | x => psi1
def ClaudeUndec.wrank : ℕ → ℕ :=
fun x =>
  match x with
  | 1 => 0
  | 4 => 1
  | 3 => 2
  | 2 => 3
  | x => 4
def ClaudeUndec.red : ℕ → ℕ → Nat.Partrec.Code → Sentence :=
fun p τ c => conj (wit p τ) (theta (univProg (Encodable.encode c)))
def ClaudeUndec.red2 : ℕ → ℕ → ℕ → Nat.Partrec.Code → Sentence :=
fun p a b c => join (wit p a) (conj (wit p b) (theta (univProg (Encodable.encode c))))
def ClaudeUndec.univProg : ℕ → Prog :=
fun m => univPre ++ loadPart (hLen + 4) m
def ClaudeUndec.theta : Prog → Sentence :=
fun P =>
  ((thRels P, thFuns P),
    baseClauses P ++
      List.flatMap
        (fun ℓ =>
          match P[ℓ]? with
          | some i => transClauses P ℓ i
          | none => [])
        (List.range (List.length P)))
