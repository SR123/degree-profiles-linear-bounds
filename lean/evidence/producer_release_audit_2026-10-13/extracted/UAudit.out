    A.Nonempty →
      (∃ τ ∈ {1, 2, 3, 4}, τ ∉ A) →
        ¬∃ D, Partrec D ∧ ∀ (φ : Sentence), Promised φ → ∃ b ∈ D φ, b = true ↔ ∃ τ ∈ A, PCType (template φ K) τ
@decides_of_promise : ∀ {α : Type} [inst : Primcodable α] {D : Sentence →. Bool},
  Partrec D →
    ∀ {Q : Sentence → Prop},
      (∀ (φ : Sentence), Promised φ → ∃ b ∈ D φ, b = true ↔ Q φ) →
        ∀ (f : α → Sentence), Computable f → (∀ (c : α), Promised (f c)) → ComputablePred fun c => Q (f c)
