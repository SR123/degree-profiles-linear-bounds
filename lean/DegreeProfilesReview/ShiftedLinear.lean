/-
Stage 5, step 1: the shifted cyclic construction, at the level of linear algebra.

Let a group `Γ` act linearly on `V` (`ρ`), let `s : ι → Γ` be finitely many group elements and
`c : ι → K` scalars.  Put

      `z = ∑ i, c i • (ρ (s i) - 1)`                                   (`zOp`)

and

      `sc ρ = image of ker z in V / range z  =  ker z / (ker z ∩ range z)`   (`sc`).

For `s` a basis of an elementary abelian `p`-group `A`, `char K = p` and `c` linearly
independent over the prime field this is the unit component of the functor `φ_a` of Hone et
al., Definition 8.3.1 (their formula (3.2.1) with `i = 1`), for the shifted cyclic subgroup
generated by `1 + z`.  For `|ι| = 1` it is the functor `im (V^A → V_A)` of Stage 3; for
`|ι| ≥ 2` it is a different functor, and `z` is not of the form `g - 1` for a group element.

`sc` is functorial for linear maps commuting with every `s i` (`scMap`), and every element of
`Γ` commuting with every `s i` acts on it (`scRep`).

The comparison map (`psi`), for the action `γ (x ⊗ y) = γx ⊗ γy` on `X →₀ Y = K[X] ⊗ Y` and an
injection `j : F → X` into the points fixed by every `s i`:

      `F →₀ sc σ  ⟶  sc (twist σ)`,   `f ⊗ [y] ↦ [j f ⊗ y]`.

It is always injective (`psi_injective`).  It is surjective (`psi_surjective`) as soon as

      every `m ∈ ker z` that vanishes at all points `j f` lies in `range z`          (`hKL`).

This is the only place where the non-fixed points enter; `hKL` is PROVED in
`ShiftedFree.lean` / `ShiftedElemAb.lean` for an elementary abelian `p`-group and generic `c`.
The orbit-sum argument of Stage 3 cannot be reused: a vector killed by `z` need not be
invariant.

Everything here is proved; there is no external hypothesis.
-/
import DegreeProfilesReview.DeletionLinear

namespace DegreeProfilesReview.Shifted

open DegreeProfilesReview.Del

variable {K : Type*} [Field K] {Γ : Type*} [Group Γ] {ι : Type*} [Fintype ι]
  (s : ι → Γ) (c : ι → K)

/-! ### The operator `z`, and `ker z / (ker z ∩ range z)` -/

section Basic

variable {V : Type*} [AddCommGroup V] [Module K V] (ρ : Representation K Γ V)

/-- `z = ∑ i, c i • (ρ (s i) - 1)`. -/
def zOp : V →ₗ[K] V := ∑ i, c i • (ρ (s i) - LinearMap.id)

theorem zOp_apply (v : V) : zOp s c ρ v = ∑ i, c i • (ρ (s i) v - v) := by
  simp [zOp, LinearMap.sum_apply]

/-- A vector fixed by every `s i` is killed by `z`. -/
theorem zOp_eq_zero_of_fixed {v : V} (hv : ∀ i, ρ (s i) v = v) : zOp s c ρ v = 0 := by
  rw [zOp_apply]
  apply Finset.sum_eq_zero
  intro i _
  rw [hv i, sub_self, smul_zero]

/-- The image of `ker z` in `V / range z`. -/
def sc : Submodule K (V ⧸ LinearMap.range (zOp s c ρ)) :=
  (LinearMap.ker (zOp s c ρ)).map (LinearMap.range (zOp s c ρ)).mkQ

/-- The class of a vector killed by `z`. -/
def scMk (v : V) (hv : v ∈ LinearMap.ker (zOp s c ρ)) : sc s c ρ :=
  ⟨(LinearMap.range (zOp s c ρ)).mkQ v, Submodule.mem_map_of_mem hv⟩

theorem coe_scMk (v : V) (hv : v ∈ LinearMap.ker (zOp s c ρ)) :
    ((scMk s c ρ v hv : sc s c ρ) : V ⧸ LinearMap.range (zOp s c ρ)) =
      (LinearMap.range (zOp s c ρ)).mkQ v := rfl

theorem sc_induction (d : sc s c ρ) : ∃ v hv, d = scMk s c ρ v hv := by
  obtain ⟨_, ⟨v, hv, rfl⟩⟩ := d
  exact ⟨v, hv, rfl⟩

theorem scMk_congr {v w : V} (h : v = w) (hv : v ∈ LinearMap.ker (zOp s c ρ))
    (hw : w ∈ LinearMap.ker (zOp s c ρ)) : scMk s c ρ v hv = scMk s c ρ w hw := by
  subst h
  rfl

theorem scMk_eq_zero_iff (v : V) (hv : v ∈ LinearMap.ker (zOp s c ρ)) :
    scMk s c ρ v hv = 0 ↔ v ∈ LinearMap.range (zOp s c ρ) := by
  rw [← Subtype.coe_inj, coe_scMk, Submodule.coe_zero, Submodule.mkQ_apply,
    Submodule.Quotient.mk_eq_zero]

theorem scMk_eq_iff (v w : V) (hv : v ∈ LinearMap.ker (zOp s c ρ))
    (hw : w ∈ LinearMap.ker (zOp s c ρ)) :
    scMk s c ρ v hv = scMk s c ρ w hw ↔ v - w ∈ LinearMap.range (zOp s c ρ) := by
  rw [← Subtype.coe_inj, coe_scMk, coe_scMk, Submodule.mkQ_apply, Submodule.mkQ_apply,
    Submodule.Quotient.eq]

end Basic

/-! ### Functoriality -/

section Functorial

variable {V W U : Type*} [AddCommGroup V] [Module K V] [AddCommGroup W] [Module K W]
  [AddCommGroup U] [Module K U]
  (ρ : Representation K Γ V) (σ : Representation K Γ W) (υ : Representation K Γ U)

/-- `f` commutes with every `s i`. -/
def SEquivariant (f : V →ₗ[K] W) : Prop := ∀ i v, f (ρ (s i) v) = σ (s i) (f v)

variable {s ρ σ υ}

theorem SEquivariant.zOp_comm {f : V →ₗ[K] W} (hf : SEquivariant s ρ σ f) (v : V) :
    f (zOp s c ρ v) = zOp s c σ (f v) := by
  rw [zOp_apply, zOp_apply, map_sum]
  apply Finset.sum_congr rfl
  intro i _
  rw [map_smul, map_sub, hf i]

theorem map_mem_ker {f : V →ₗ[K] W} (hf : SEquivariant s ρ σ f) {v : V}
    (hv : v ∈ LinearMap.ker (zOp s c ρ)) : f v ∈ LinearMap.ker (zOp s c σ) := by
  rw [LinearMap.mem_ker] at hv ⊢
  rw [← hf.zOp_comm c, hv, map_zero]

theorem range_le_comap {f : V →ₗ[K] W} (hf : SEquivariant s ρ σ f) :
    LinearMap.range (zOp s c ρ) ≤ (LinearMap.range (zOp s c σ)).comap f := by
  rintro _ ⟨v, rfl⟩
  rw [Submodule.mem_comap, hf.zOp_comm c]
  exact LinearMap.mem_range_self _ _

/-- The map induced on `sc` by a linear map commuting with every `s i`. -/
def scMap (f : V →ₗ[K] W) (hf : SEquivariant s ρ σ f) : sc s c ρ →ₗ[K] sc s c σ :=
  ((LinearMap.range (zOp s c ρ)).mapQ (LinearMap.range (zOp s c σ)) f
    (range_le_comap c hf)).restrict (p := sc s c ρ) (q := sc s c σ) (by
    rintro _ ⟨v, hv, rfl⟩
    exact ⟨f v, map_mem_ker c hf hv, rfl⟩)

theorem scMap_scMk (f : V →ₗ[K] W) (hf : SEquivariant s ρ σ f) (v : V)
    (hv : v ∈ LinearMap.ker (zOp s c ρ)) :
    scMap c f hf (scMk s c ρ v hv) = scMk s c σ (f v) (map_mem_ker c hf hv) := rfl

omit [Fintype ι] in
theorem SEquivariant.comp {f : V →ₗ[K] W} {g : W →ₗ[K] U} (hf : SEquivariant s ρ σ f)
    (hg : SEquivariant s σ υ g) : SEquivariant s ρ υ (g ∘ₗ f) := fun i v => by
  rw [LinearMap.comp_apply, hf i, hg i, LinearMap.comp_apply]

omit [Fintype ι] in
theorem SEquivariant.symm (e : V ≃ₗ[K] W) (he : SEquivariant s ρ σ e.toLinearMap) :
    SEquivariant s σ ρ e.symm.toLinearMap := fun i w => by
  apply e.injective
  have := he i (e.symm w)
  simp only [LinearEquiv.coe_coe, LinearEquiv.apply_symm_apply] at this ⊢
  exact this.symm

/-- A linear equivalence commuting with every `s i` induces a linear equivalence on `sc`. -/
def scEquiv (e : V ≃ₗ[K] W) (he : SEquivariant s ρ σ e.toLinearMap) :
    sc s c ρ ≃ₗ[K] sc s c σ :=
  LinearEquiv.ofLinear (scMap c e.toLinearMap he) (scMap c e.symm.toLinearMap (he.symm e))
    (by
      apply LinearMap.ext
      intro d
      obtain ⟨w, hw, rfl⟩ := sc_induction s c σ d
      rw [LinearMap.comp_apply, scMap_scMk, scMap_scMk]
      apply Subtype.ext
      simp [coe_scMk])
    (by
      apply LinearMap.ext
      intro d
      obtain ⟨v, hv, rfl⟩ := sc_induction s c ρ d
      rw [LinearMap.comp_apply, scMap_scMk, scMap_scMk]
      apply Subtype.ext
      simp [coe_scMk])

theorem scEquiv_scMk (e : V ≃ₗ[K] W) (he : SEquivariant s ρ σ e.toLinearMap) (v : V)
    (hv : v ∈ LinearMap.ker (zOp s c ρ)) :
    scEquiv c e he (scMk s c ρ v hv) = scMk s c σ (e v) (map_mem_ker c he hv) := rfl

end Functorial

/-! ### The residual action -/

section Residual

variable {V : Type*} [AddCommGroup V] [Module K V] (ρ : Representation K Γ V)
  {G₀ : Type*} [Group G₀] (i : G₀ →* Γ) (hcomm : ∀ g k, i g * s k = s k * i g)

omit [Fintype ι] in
include hcomm in
theorem sequivariant_of_comm (g : G₀) : SEquivariant s ρ ρ (ρ (i g)) := fun k v => by
  rw [← Module.End.mul_apply, ← map_mul, hcomm g k, map_mul, Module.End.mul_apply]

/-- The action on `sc` of a group commuting with every `s i`. -/
def scRep : Representation K G₀ (sc s c ρ) where
  toFun g := scMap c (ρ (i g)) (sequivariant_of_comm s ρ i hcomm g)
  map_one' := by
    apply LinearMap.ext
    intro d
    obtain ⟨v, hv, rfl⟩ := sc_induction s c ρ d
    rw [scMap_scMk]
    apply Subtype.ext
    simp [coe_scMk]
  map_mul' := fun g h => by
    apply LinearMap.ext
    intro d
    obtain ⟨v, hv, rfl⟩ := sc_induction s c ρ d
    rw [Module.End.mul_apply, scMap_scMk, scMap_scMk, scMap_scMk]
    apply Subtype.ext
    simp [coe_scMk]

theorem scRep_scMk (g : G₀) (v : V) (hv : v ∈ LinearMap.ker (zOp s c ρ)) :
    scRep s c ρ i hcomm g (scMk s c ρ v hv) =
      scMk s c ρ (ρ (i g) v) (map_mem_ker c (sequivariant_of_comm s ρ i hcomm g) hv) := rfl

end Residual

/-! ### The comparison map -/

section Psi

variable {X : Type*} [MulAction Γ X] {Y : Type*} [AddCommGroup Y] [Module K Y]
  (σ : Representation K Γ Y) {F : Type*} (j : F → X)
  (hfix : ∀ f k, s k • j f = j f)

omit [Fintype ι] in
include hfix in
theorem lsingle_sequivariant (f : F) :
    SEquivariant s σ (twist (X := X) σ) (Finsupp.lsingle (j f)) := fun k y => by
  rw [Finsupp.lsingle_apply, Finsupp.lsingle_apply, twist_single, hfix f k]

omit [Fintype ι] in
include hfix in
theorem lapply_sequivariant (f : F) :
    SEquivariant s (twist (X := X) σ) σ (Finsupp.lapply (j f)) := fun k m => by
  rw [Finsupp.lapply_apply, Finsupp.lapply_apply]
  conv_lhs => rw [← hfix f k]
  exact twist_smul_apply σ (s k) m (j f)

/-- `f ⊗ [y] ↦ [j f ⊗ y]`. -/
noncomputable def psi : (F →₀ sc s c σ) →ₗ[K] sc s c (twist (X := X) σ) :=
  Finsupp.lsum K fun f => scMap c (Finsupp.lsingle (j f)) (lsingle_sequivariant s σ j hfix f)

theorem psi_single (f : F) (y : Y) (hy : y ∈ LinearMap.ker (zOp s c σ)) :
    psi s c σ j hfix (Finsupp.single f (scMk s c σ y hy)) =
      scMk s c (twist σ) (Finsupp.single (j f) y)
        (map_mem_ker c (lsingle_sequivariant s σ j hfix f) hy) := by
  simp [psi, scMap_scMk]

variable (hj : Function.Injective j)

include hj in
/-- Evaluation at a fixed point recovers the coefficient. -/
theorem eval_psi (f₀ : F) :
    scMap c (Finsupp.lapply (j f₀)) (lapply_sequivariant s σ j hfix f₀) ∘ₗ psi s c σ j hfix =
      Finsupp.lapply f₀ := by
  classical
  apply Finsupp.lhom_ext'
  intro f
  apply LinearMap.ext
  intro d
  obtain ⟨y, hy, rfl⟩ := sc_induction s c σ d
  rw [LinearMap.comp_apply, LinearMap.comp_apply, Finsupp.lsingle_apply, psi_single,
    scMap_scMk, LinearMap.comp_apply, Finsupp.lsingle_apply]
  apply Subtype.ext
  rw [coe_scMk, Finsupp.lapply_apply, Finsupp.lapply_apply, Finsupp.single_apply,
    Finsupp.single_apply]
  by_cases h : f = f₀
  · subst h
    rw [if_pos rfl, if_pos rfl, coe_scMk]
  · rw [if_neg h, if_neg (fun h' => h (hj h')), map_zero, Submodule.coe_zero]

include hj in
theorem psi_injective : Function.Injective (psi s c σ j hfix) := by
  rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
  intro v hv
  ext f₀
  have h := LinearMap.congr_fun (eval_psi s c σ j hfix hj f₀) v
  rw [LinearMap.comp_apply, hv, map_zero, Finsupp.lapply_apply] at h
  rw [← h, Finsupp.zero_apply, Submodule.coe_zero]

/-! ### Surjectivity, given that the non-fixed part contributes nothing -/

/-- The hypothesis on the non-fixed points: a vector killed by `z` and vanishing at every
`j f` lies in the range of `z`.  (Proved in `ShiftedElemAb.lean` in the intended situation.) -/
def NonfixedAcyclic : Prop :=
  ∀ m : X →₀ Y, zOp s c (twist (X := X) σ) m = 0 → (∀ f, m (j f) = 0) →
    m ∈ LinearMap.range (zOp s c (twist (X := X) σ))

include hj in
theorem psi_surjective [Finite X] (hKL : NonfixedAcyclic s c σ j) :
    Function.Surjective (psi s c σ j hfix) := by
  classical
  haveI : Finite F := Finite.of_injective j hj
  haveI := Fintype.ofFinite F
  intro d
  obtain ⟨m, hm, rfl⟩ := sc_induction s c _ d
  have hcoef : ∀ f, m (j f) ∈ LinearMap.ker (zOp s c σ) := fun f =>
    map_mem_ker c (lapply_sequivariant s σ j hfix f) hm
  -- the part of `m` on the fixed points
  set mfix : X →₀ Y := ∑ f : F, Finsupp.single (j f) (m (j f)) with hmfix
  have hmfix_ker : mfix ∈ LinearMap.ker (zOp s c (twist (X := X) σ)) := by
    rw [hmfix]
    apply Submodule.sum_mem
    intro f _
    exact map_mem_ker c (lsingle_sequivariant s σ j hfix f) (hcoef f)
  have hmfix_apply : ∀ f₀, mfix (j f₀) = m (j f₀) := by
    intro f₀
    rw [hmfix, Finsupp.finset_sum_apply, Finset.sum_eq_single f₀]
    · rw [Finsupp.single_eq_same]
    · intro f _ hne
      rw [Finsupp.single_apply, if_neg (fun h => hne (hj h))]
    · intro h
      exact absurd (Finset.mem_univ f₀) h
  have hdiff : m - mfix ∈ LinearMap.range (zOp s c (twist (X := X) σ)) := by
    apply hKL
    · rw [map_sub, LinearMap.mem_ker.mp hm, LinearMap.mem_ker.mp hmfix_ker, sub_zero]
    · intro f
      rw [Finsupp.sub_apply, hmfix_apply, sub_self]
  refine ⟨∑ f : F, Finsupp.single f (scMk s c σ (m (j f)) (hcoef f)), ?_⟩
  rw [map_sum]
  simp only [psi_single]
  apply Subtype.ext
  rw [Submodule.coe_sum, coe_scMk]
  simp only [coe_scMk]
  rw [← map_sum, ← hmfix, Submodule.mkQ_apply, Submodule.mkQ_apply, Submodule.Quotient.eq]
  have : mfix - m = -(m - mfix) := by abel
  rw [this]
  exact Submodule.neg_mem _ hdiff

include hj in
theorem psi_bijective [Finite X] (hKL : NonfixedAcyclic s c σ j) :
    Function.Bijective (psi s c σ j hfix) :=
  ⟨psi_injective s c σ j hfix hj, psi_surjective s c σ j hfix hj hKL⟩

end Psi

end DegreeProfilesReview.Shifted
