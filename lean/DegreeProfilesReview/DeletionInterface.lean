/-
Stage 2, step 4: the representation-theoretic interface, for fixed numbers `p, q, r, n`
(`N = n + q`), as five separately named structures `M1 … M5`.

Nothing here mentions a template, a polynomial, a proof system, a consequence space, a
refutation or a period.  The five inputs are statements about categories of representations
of `S_N` and `S_n`:

* `M1`  the restricted polynomial-functor equivalence with its action on simple labels;
* `M2`  the Schur functors as Serre quotients onto abelian categories `B_N`, `B_n`;
* `M3`  the concrete functor `Φ : B_N ⥤ B_n` and its natural commutation;
* `M4`  (one copy for each rank) `B_t` is a category of representations of `S_t`: it has an
        exact faithful underlying-space functor, it sits fully faithfully in an ambient tensor
        category with a monoidal underlying-space functor, it contains the permutation
        modules of basis systems of support `≤ r`, the maps given by relabelling-invariant
        matrices, and the ambient subobjects `X ⊗ S ⊆ X ⊗ L`;
* `M5`  `Φ` is the restriction of an ambient MONOIDAL functor (not assumed exact), and on
        permutation modules it is the fixed-point identification, naturally in invariant
        matrices and compatibly with products.

Categorical distinction kept: monoidality is a property of the ambient functors `Ω`, `J`,
`Φhat` only; exactness is a property of `ω` and (derived) of `Φ` on the bounded-tail
categories only.  `B_N`, `B_n` are not assumed to be closed under tensor products.

Derived here, not assumed:
* `Φ` is an equivalence, hence exact and faithful (`M1–M3` and the partition combinatorics);
* the morphism `X ⊗ S ⟶ X ⊗ L` inside `B_t` (`PermutationModules.tens`), from fullness;
* its underlying linear map is `id ⊗ s` (`tens_ω_spec`), from monoidality of `Ω`;
* `Φ` carries it to the corresponding morphism at rank `n` (`tens_Φ_spec`), from monoidality
  of `Φhat` and `J` and full faithfulness.
-/
import DegreeProfilesReview.SerreDescent
import DegreeProfilesReview.PCTransport
import DegreeProfilesReview.MonoidalCompat
import DegreeProfilesReview.BasisSystems
import Mathlib.Algebra.Category.ModuleCat.Monoidal.Basic
import Mathlib.Algebra.Category.ModuleCat.Abelian
import Mathlib.CategoryTheory.Adjunction.Limits
import Mathlib.LinearAlgebra.DirectSum.Finsupp

universe v₁ v₂ v₃ v₄ u₁ u₂ u₃ u₄

open CategoryTheory CategoryTheory.Limits MonoidalCategory

namespace DegreeProfilesReview.Deletion

open DegreeProfilesReview.StablePartitions DegreeProfilesReview.SerreDescent
open DegreeProfilesReview.Uniform DegreeProfilesReview.MonoidalCompat

/-! ### M1 -/

/-- **M1** (Hone et al., Theorem 8.3.3, Lemmas 8.4.3–8.4.4, Theorem 8.4.5, restricted to
bounded-tail labels; Harman, Cor. 1.6).  Abelian categories `C_N`, `C_n` (the Serre
subcategories of polynomial functors generated by the simple objects with labels of tail
`≤ r`), an equivalence between them, and its action on simple labels: the label `λ ⊢ n + q`
goes to `λ - q e₁`. -/
structure M1 (q r n : ℕ) where
  CN : Type u₁
  Cn : Type u₁
  [catN : Category.{v₁} CN]
  [catn : Category.{v₁} Cn]
  [abN : Abelian CN]
  [abn : Abelian Cn]
  E : CN ≌ Cn
  labN : List ℕ → CN
  labn : List ℕ → Cn
  lab_compat : ∀ l, BoundedTail (n + q) r l →
    Nonempty (E.functor.obj (labN l) ≅ labn (delFirst q l))

attribute [instance] M1.catN M1.catn M1.abN M1.abn

/-! ### M2 -/

/-- **M2** (Hone et al., §7.3, Lemma 8.5.1, Cor. 8.5.2(2) adapted to bounded tails; James'
theorem on `D^λ`).  Abelian categories `B_N`, `B_n` and the Schur functors onto them, each a
Serre quotient whose kernel is the Serre class generated by the `p`-singular labels. -/
structure M2 (p : ℕ) {q r n : ℕ} (m1 : M1.{v₁, u₁} q r n) where
  BN : Type u₂
  Bn : Type u₂
  [catBN : Category.{v₂} BN]
  [catBn : Category.{v₂} Bn]
  [abBN : Abelian BN]
  [abBn : Abelian Bn]
  schurN : m1.CN ⥤ BN
  schurn : m1.Cn ⥤ Bn
  locN : schurN.IsLocalization
    (serreClosure (singularGenerators p (n + q) r m1.labN)).isoModSerre
  locn : schurn.IsLocalization
    (serreClosure (singularGenerators p n r m1.labn)).isoModSerre

attribute [instance] M2.catBN M2.catBn M2.abBN M2.abBn

/-! ### M3 -/

/-- **M3** (Hone et al., Lemma 7.3.2).  The concrete functor on the Schur images and its
natural commutation with the Schur functors.  Exactness of `Φ` is NOT a field. -/
structure M3 {p q r n : ℕ} {m1 : M1.{v₁, u₁} q r n} (m2 : M2.{v₁, v₂, u₁, u₂} p m1) where
  Φ : m2.BN ⥤ m2.Bn
  comm : m2.schurN ⋙ Φ ≅ m1.E.functor ⋙ m2.schurn

/-- Derived from M1–M3 and the partition combinatorics: `Φ` is an equivalence. -/
theorem M3.isEquivalence {p q r n : ℕ} {m1 : M1.{v₁, u₁} q r n}
    {m2 : M2.{v₁, v₂, u₁, u₂} p m1} (m3 : M3 m2) (hp : 2 ≤ p) (hn : 2 * r < n) :
    m3.Φ.IsEquivalence :=
  haveI := m2.locN
  haveI := m2.locn
  boundedTail_descent hp hn m1.labN m1.labn m1.E m1.lab_compat m2.schurN m2.schurn m3.Φ m3.comm

/-! ### M4 -/

/-- `K[A] ⊗ K[B] = K[A × B]`, basis element to basis element, as an isomorphism of vector
spaces. -/
noncomputable def prodBasis (K : Type) [Field K] (A B : Type) :
    ModuleCat.of K (A →₀ K) ⊗ ModuleCat.of K (B →₀ K) ≅ ModuleCat.of K (A × B →₀ K) :=
  (finsuppTensorFinsupp' K A B).toModuleIso

/-- **M4** at rank `t` (Hone et al., §7.3, with the manuscript's closure of the Schur image
under ambient subobjects and quotients).  `B` is a category of representations of `S_t`
containing the permutation modules of basis systems of support `≤ r`.

* `ω` — the underlying vector space; exact and faithful on `B`.
* `R, ι, Ω, β` — the ambient tensor category of all representations, the full embedding, the
  monoidal underlying-space functor, and the agreement of the two underlying spaces.
* `perm, basis` — the permutation module `K[𝒰_t]` with its standard basis.
* `mat, mat_spec` — the linear map with a relabelling-invariant matrix is a morphism of `B`.
* `prodIso, prodIso_spec` — `K[𝒰_t] ⊗ K[𝒱_t] = K[(𝒰 × 𝒱)_t]` in the ambient category,
  basis element to basis element.
* `sub, subIso` — for a subobject `S ⊆ K[𝒱_t]` in `B`, the ambient object `K[𝒰_t] ⊗ S`
  (an ambient subobject of `K[(𝒰 × 𝒱)_t]`) is again in `B`.

No closure of `B` under tensor products is assumed beyond the last item. -/
structure M4 (K : Type) [Field K] (r t : ℕ) (B : Type u₂) [Category.{v₂} B] [Abelian B] where
  ω : B ⥤ ModuleCat.{0} K
  [ω_zero : ω.PreservesZeroMorphisms]
  [ω_lim : PreservesFiniteLimits ω]
  [ω_colim : PreservesFiniteColimits ω]
  [ω_faithful : ω.Faithful]
  R : Type u₃
  [catR : Category.{v₃} R]
  [monR : MonoidalCategory R]
  ι : B ⥤ R
  [ι_full : ι.Full]
  [ι_faithful : ι.Faithful]
  Ω : R ⥤ ModuleCat.{0} K
  [Ω_monoidal : Ω.Monoidal]
  β : ι ⋙ Ω ≅ ω
  perm : ∀ 𝒰 : BasisSystem, 𝒰.Bounded r → B
  basis : ∀ (𝒰 : BasisSystem) (h : 𝒰.Bounded r),
    ω.obj (perm 𝒰 h) ≅ ModuleCat.of K (𝒰.Rk t →₀ K)
  mat : ∀ {𝒰 𝒱 : BasisSystem} (hU : 𝒰.Bounded r) (hV : 𝒱.Bounded r),
    InvMatrix K 𝒰 𝒱 → (perm 𝒰 hU ⟶ perm 𝒱 hV)
  mat_spec : ∀ {𝒰 𝒱 : BasisSystem} (hU : 𝒰.Bounded r) (hV : 𝒱.Bounded r)
    (a : InvMatrix K 𝒰 𝒱),
    ω.map (mat hU hV a) ≫ (basis 𝒱 hV).hom =
      (basis 𝒰 hU).hom ≫ ModuleCat.ofHom (a.realise t)
  prodIso : ∀ {𝒰 𝒱 : BasisSystem} (hU : 𝒰.Bounded r) (hV : 𝒱.Bounded r)
    (hUV : (𝒰.prod 𝒱).Bounded r),
    ι.obj (perm 𝒰 hU) ⊗ ι.obj (perm 𝒱 hV) ≅ ι.obj (perm (𝒰.prod 𝒱) hUV)
  prodIso_spec : ∀ {𝒰 𝒱 : BasisSystem} (hU : 𝒰.Bounded r) (hV : 𝒱.Bounded r)
    (hUV : (𝒰.prod 𝒱).Bounded r),
    Functor.LaxMonoidal.μ Ω (ι.obj (perm 𝒰 hU)) (ι.obj (perm 𝒱 hV)) ≫
        Ω.map (prodIso hU hV hUV).hom ≫ β.hom.app (perm (𝒰.prod 𝒱) hUV) ≫
          (basis (𝒰.prod 𝒱) hUV).hom =
      ((β.hom.app (perm 𝒰 hU) ≫ (basis 𝒰 hU).hom) ⊗ₘ
          (β.hom.app (perm 𝒱 hV) ≫ (basis 𝒱 hV).hom)) ≫
        (prodBasis K (𝒰.Rk t) (𝒱.Rk t)).hom
  sub : ∀ {𝒰 𝒱 : BasisSystem} (_ : 𝒰.Bounded r) (hV : 𝒱.Bounded r)
    (_ : (𝒰.prod 𝒱).Bounded r) {S : B} (s : S ⟶ perm 𝒱 hV) [Mono s], B
  subIso : ∀ {𝒰 𝒱 : BasisSystem} (hU : 𝒰.Bounded r) (hV : 𝒱.Bounded r)
    (hUV : (𝒰.prod 𝒱).Bounded r) {S : B} (s : S ⟶ perm 𝒱 hV) [Mono s],
    ι.obj (sub hU hV hUV s) ≅ ι.obj (perm 𝒰 hU) ⊗ ι.obj S

attribute [instance] M4.ω_zero M4.ω_lim M4.ω_colim M4.ω_faithful M4.catR M4.monR M4.ι_full
  M4.ι_faithful M4.Ω_monoidal

namespace M4

variable {K : Type} [Field K] {r t : ℕ} {B : Type u₂} [Category.{v₂} B] [Abelian B]
  (P : M4.{v₂, v₃, u₂, u₃} K r t B)

/-- The morphism `K[𝒰_t] ⊗ S ⟶ K[(𝒰 × 𝒱)_t]` of `B`: the unique morphism whose ambient image
is `X ⊗ S ⟶ X ⊗ L ≅ K[(𝒰 × 𝒱)_t]`.  Obtained from fullness of `ι`; not a field. -/
noncomputable def tens {𝒰 𝒱 : BasisSystem} (hU : 𝒰.Bounded r) (hV : 𝒱.Bounded r)
    (hUV : (𝒰.prod 𝒱).Bounded r) {S : B} (s : S ⟶ P.perm 𝒱 hV) [Mono s] :
    P.sub hU hV hUV s ⟶ P.perm (𝒰.prod 𝒱) hUV :=
  P.ι.preimage ((P.subIso hU hV hUV s).hom ≫ (P.ι.obj (P.perm 𝒰 hU) ◁ P.ι.map s) ≫
    (P.prodIso hU hV hUV).hom)

theorem ι_tens {𝒰 𝒱 : BasisSystem} (hU : 𝒰.Bounded r) (hV : 𝒱.Bounded r)
    (hUV : (𝒰.prod 𝒱).Bounded r) {S : B} (s : S ⟶ P.perm 𝒱 hV) [Mono s] :
    P.ι.map (P.tens hU hV hUV s) = (P.subIso hU hV hUV s).hom ≫
      (P.ι.obj (P.perm 𝒰 hU) ◁ P.ι.map s) ≫ (P.prodIso hU hV hUV).hom :=
  P.ι.map_preimage _

/-- The underlying linear map of a morphism of `B`, through the ambient category. -/
theorem ω_map_eq {A A' : B} (f : A ⟶ A') :
    P.ω.map f = P.β.inv.app A ≫ P.Ω.map (P.ι.map f) ≫ P.β.hom.app A' := by
  have h := P.β.hom.naturality f
  rw [Functor.comp_map] at h
  rw [h, Iso.inv_hom_id_app_assoc]

/-- **Underlying linear map of `tens`.**  Under the standard bases, and any further
identification `EL` of `K[𝒱_t]`, the underlying map of `K[𝒰_t] ⊗ S ⟶ K[(𝒰 × 𝒱)_t]` is
`id ⊗ s'`, where `s'` is the underlying map of `s`.  Proof: monoidality of `Ω` and
`prodIso_spec`. -/
theorem tens_ω_spec {𝒰 𝒱 : BasisSystem} (hU : 𝒰.Bounded r) (hV : 𝒱.Bounded r)
    (hUV : (𝒰.prod 𝒱).Bounded r) {S : B} (s : S ⟶ P.perm 𝒱 hV) [Mono s]
    {L' S' : ModuleCat.{0} K} (EL : ModuleCat.of K (𝒱.Rk t →₀ K) ≅ L') (s' : S' ⟶ L')
    (e : P.ω.obj S ≅ S') (hs : P.ω.map s ≫ (P.basis 𝒱 hV).hom ≫ EL.hom = e.hom ≫ s') :
    ∃ eT : P.ω.obj (P.sub hU hV hUV s) ≅ ModuleCat.of K (𝒰.Rk t →₀ K) ⊗ S',
      P.ω.map (P.tens hU hV hUV s) ≫ (P.basis (𝒰.prod 𝒱) hUV).hom ≫
          (prodBasis K (𝒰.Rk t) (𝒱.Rk t)).inv ≫
          (ModuleCat.of K (𝒰.Rk t →₀ K) ◁ EL.hom) =
        eT.hom ≫ (ModuleCat.of K (𝒰.Rk t →₀ K) ◁ s') := by
  let aX : P.Ω.obj (P.ι.obj (P.perm 𝒰 hU)) ≅ ModuleCat.of K (𝒰.Rk t →₀ K) :=
    P.β.app (P.perm 𝒰 hU) ≪≫ P.basis 𝒰 hU
  let aS : P.Ω.obj (P.ι.obj S) ≅ S' := P.β.app S ≪≫ e
  refine ⟨(P.β.app _).symm ≪≫ P.Ω.mapIso (P.subIso hU hV hUV s) ≪≫
    (Functor.Monoidal.μIso P.Ω _ _).symm ≪≫ tensorIso aX aS, ?_⟩
  have hcancel := (prodBasis K (𝒰.Rk t) (𝒱.Rk t)).hom_inv_id
  -- naturality of `β` at `s`
  have hnat : P.Ω.map (P.ι.map s) ≫ P.β.hom.app (P.perm 𝒱 hV) = P.β.hom.app S ≫ P.ω.map s :=
    P.β.hom.naturality s
  have hS : P.Ω.map (P.ι.map s) ≫ (P.β.hom.app (P.perm 𝒱 hV) ≫ (P.basis 𝒱 hV).hom) ≫ EL.hom =
      aS.hom ≫ s' := by
    rw [Category.assoc, ← Category.assoc, hnat, Category.assoc, hs]
    simp [aS]
  rw [P.ω_map_eq, P.ι_tens, Functor.map_comp, Functor.map_comp,
    Functor.Monoidal.map_whiskerLeft]
  simp only [Category.assoc, Iso.trans_hom, Iso.symm_hom, Iso.app_inv, Functor.mapIso_hom,
    tensorIso_hom]
  congr 2
  rw [reassoc_of% (P.prodIso_spec hU hV hUV), reassoc_of% hcancel,
    tensorHom_comp_whiskerLeft, whiskerLeft_comp_tensorHom, tensorHom_comp_whiskerLeft, hS]
  rfl

end M4

/-! ### M5 -/

/-- **M5** (Hone et al., Lemma 4.2.4(i),(v), Prop. 6.1.4(1), Lemma 5.1.6; strict range
`q > r`).  The functor `Φ` on the bounded-tail categories is the restriction of an ambient
MONOIDAL functor `Φhat` into a tensor category `𝒯` that contains the representations of `S_n`
through a monoidal full embedding `J`; on the permutation module of a basis system of support
`≤ r` it is the identification `K[(𝒰_N)^H] = K[𝒰_n]`, naturally for invariant matrices and
compatibly with products.  `Φhat` is NOT assumed exact. -/
structure M5 {K : Type} [Field K] {r N n : ℕ}
    {BN : Type u₂} [Category.{v₂} BN] [Abelian BN] {Bn : Type u₂} [Category.{v₂} Bn] [Abelian Bn]
    (PN : M4.{v₂, v₃, u₂, u₃} K r N BN) (Pn : M4.{v₂, v₃, u₂, u₃} K r n Bn) (Φ : BN ⥤ Bn) where
  𝒯 : Type u₄
  [cat𝒯 : Category.{v₄} 𝒯]
  [mon𝒯 : MonoidalCategory 𝒯]
  J : Pn.R ⥤ 𝒯
  [J_monoidal : J.Monoidal]
  [J_full : J.Full]
  [J_faithful : J.Faithful]
  Φhat : PN.R ⥤ 𝒯
  [Φhat_monoidal : Φhat.Monoidal]
  γ : PN.ι ⋙ Φhat ≅ Φ ⋙ Pn.ι ⋙ J
  δ : ∀ (𝒰 : BasisSystem) (h : 𝒰.Bounded r), Φ.obj (PN.perm 𝒰 h) ≅ Pn.perm 𝒰 h
  δ_mat : ∀ {𝒰 𝒱 : BasisSystem} (hU : 𝒰.Bounded r) (hV : 𝒱.Bounded r) (a : InvMatrix K 𝒰 𝒱),
    Φ.map (PN.mat hU hV a) ≫ (δ 𝒱 hV).hom = (δ 𝒰 hU).hom ≫ Pn.mat hU hV a
  δ_prod : ∀ {𝒰 𝒱 : BasisSystem} (hU : 𝒰.Bounded r) (hV : 𝒱.Bounded r)
    (hUV : (𝒰.prod 𝒱).Bounded r),
    Φhat.map (PN.prodIso hU hV hUV).hom ≫ γ.hom.app (PN.perm (𝒰.prod 𝒱) hUV) ≫
        J.map (Pn.ι.map (δ (𝒰.prod 𝒱) hUV).hom) =
      (tensorComparison Φhat
          (γ.app (PN.perm 𝒰 hU) ≪≫ J.mapIso (Pn.ι.mapIso (δ 𝒰 hU)))
          (γ.app (PN.perm 𝒱 hV) ≪≫ J.mapIso (Pn.ι.mapIso (δ 𝒱 hV)))).hom ≫
        Functor.LaxMonoidal.μ J (Pn.ι.obj (Pn.perm 𝒰 hU)) (Pn.ι.obj (Pn.perm 𝒱 hV)) ≫
        J.map (Pn.prodIso hU hV hUV).hom

attribute [instance] M5.cat𝒯 M5.mon𝒯 M5.J_monoidal M5.J_full M5.J_faithful M5.Φhat_monoidal

namespace M5

variable {K : Type} [Field K] {r N n : ℕ}
  {BN : Type u₂} [Category.{v₂} BN] [Abelian BN] {Bn : Type u₂} [Category.{v₂} Bn] [Abelian Bn]
  {PN : M4.{v₂, v₃, u₂, u₃} K r N BN} {Pn : M4.{v₂, v₃, u₂, u₃} K r n Bn} {Φ : BN ⥤ Bn}
  (m5 : M5.{v₂, v₃, v₄, u₂, u₃, u₄} PN Pn Φ)

/-- The comparison `Φhat (K[𝒰_N]) ≅ J (K[𝒰_n])` in the ambient target. -/
noncomputable def α (𝒰 : BasisSystem) (h : 𝒰.Bounded r) :
    m5.Φhat.obj (PN.ι.obj (PN.perm 𝒰 h)) ≅ m5.J.obj (Pn.ι.obj (Pn.perm 𝒰 h)) :=
  m5.γ.app (PN.perm 𝒰 h) ≪≫ m5.J.mapIso (Pn.ι.mapIso (m5.δ 𝒰 h))

/-- Naturality of `γ`, in components. -/
theorem γ_nat {A A' : BN} (f : A ⟶ A') :
    m5.Φhat.map (PN.ι.map f) ≫ m5.γ.hom.app A' =
      m5.γ.hom.app A ≫ m5.J.map (Pn.ι.map (Φ.map f)) :=
  m5.γ.hom.naturality f

/-- **`Φ` is compatible with `X ⊗ S ⟶ X ⊗ L`.**  Derived from monoidality of the ambient
functors `Φhat` and `J`, the product compatibility `δ_prod`, and full faithfulness of the
embeddings.  No exactness of `Φhat` and no tensor-closure of `B_N`, `B_n` is used. -/
theorem tens_Φ_spec {𝒰 𝒱 : BasisSystem} (hU : 𝒰.Bounded r) (hV : 𝒱.Bounded r)
    (hUV : (𝒰.prod 𝒱).Bounded r) {S : BN} (s : S ⟶ PN.perm 𝒱 hV) [Mono s]
    {S' : Bn} (s' : S' ⟶ Pn.perm 𝒱 hV) [Mono s'] (e : Φ.obj S ≅ S')
    (hs : Φ.map s ≫ (m5.δ 𝒱 hV).hom = e.hom ≫ s') :
    ∃ eT : Φ.obj (PN.sub hU hV hUV s) ≅ Pn.sub hU hV hUV s',
      Φ.map (PN.tens hU hV hUV s) ≫ (m5.δ (𝒰.prod 𝒱) hUV).hom =
        eT.hom ≫ Pn.tens hU hV hUV s' := by
  let aS : m5.Φhat.obj (PN.ι.obj S) ≅ m5.J.obj (Pn.ι.obj S') :=
    m5.γ.app S ≪≫ m5.J.mapIso (Pn.ι.mapIso e)
  let θ : m5.J.obj (Pn.ι.obj (Φ.obj (PN.sub hU hV hUV s))) ≅
      m5.J.obj (Pn.ι.obj (Pn.sub hU hV hUV s')) :=
    (m5.γ.app (PN.sub hU hV hUV s)).symm ≪≫ m5.Φhat.mapIso (PN.subIso hU hV hUV s) ≪≫
      tensorComparison m5.Φhat (m5.α 𝒰 hU) aS ≪≫ Functor.Monoidal.μIso m5.J _ _ ≪≫
      m5.J.mapIso (Pn.subIso hU hV hUV s').symm
  refine ⟨Pn.ι.preimageIso (m5.J.preimageIso θ), ?_⟩
  apply Pn.ι.map_injective
  apply m5.J.map_injective
  -- the square for `s` in the ambient target
  have hsq : m5.Φhat.map (PN.ι.map s) ≫ (m5.α 𝒱 hV).hom = aS.hom ≫ m5.J.map (Pn.ι.map s') := by
    simp only [α, aS, Iso.trans_hom, Functor.mapIso_hom, Iso.app_hom]
    rw [← Category.assoc, m5.γ_nat, Category.assoc, ← Functor.map_comp, ← Functor.map_comp, hs,
      Functor.map_comp, Functor.map_comp, Category.assoc]
  have hw := whiskerLeft_compat m5.Φhat (m5.α 𝒰 hU) (m5.α 𝒱 hV) aS (PN.ι.map s)
    (m5.J.map (Pn.ι.map s')) hsq
  have hprod : m5.Φhat.map (PN.prodIso hU hV hUV).hom ≫
      m5.γ.hom.app (PN.perm (𝒰.prod 𝒱) hUV) ≫
        m5.J.map (Pn.ι.map (m5.δ (𝒰.prod 𝒱) hUV).hom) =
      (tensorComparison m5.Φhat (m5.α 𝒰 hU) (m5.α 𝒱 hV)).hom ≫
        Functor.LaxMonoidal.μ m5.J (Pn.ι.obj (Pn.perm 𝒰 hU)) (Pn.ι.obj (Pn.perm 𝒱 hV)) ≫
        m5.J.map (Pn.prodIso hU hV hUV).hom := m5.δ_prod hU hV hUV
  -- left-hand side
  have hL : m5.J.map (Pn.ι.map (Φ.map (PN.tens hU hV hUV s) ≫ (m5.δ (𝒰.prod 𝒱) hUV).hom)) =
      m5.γ.inv.app _ ≫ m5.Φhat.map (PN.subIso hU hV hUV s).hom ≫
        (tensorComparison m5.Φhat (m5.α 𝒰 hU) aS).hom ≫
        Functor.LaxMonoidal.μ m5.J _ _ ≫
        m5.J.map (Pn.ι.obj (Pn.perm 𝒰 hU) ◁ Pn.ι.map s') ≫
        m5.J.map (Pn.prodIso hU hV hUV).hom := by
    rw [Functor.map_comp, Functor.map_comp]
    have h1 : m5.J.map (Pn.ι.map (Φ.map (PN.tens hU hV hUV s))) =
        m5.γ.inv.app _ ≫ m5.Φhat.map (PN.ι.map (PN.tens hU hV hUV s)) ≫ m5.γ.hom.app _ := by
      rw [m5.γ_nat, Iso.inv_hom_id_app_assoc]
    rw [h1, PN.ι_tens, Functor.map_comp, Functor.map_comp]
    simp only [Category.assoc]
    congr 2
    rw [hprod, reassoc_of% hw, Functor.LaxMonoidal.μ_natural_right_assoc]
  rw [hL, Functor.map_comp, Functor.map_comp, Pn.ι_tens]
  simp only [Functor.preimageIso_hom, Functor.map_preimage, θ, Iso.trans_hom, Iso.symm_hom,
    Functor.mapIso_hom, Iso.app_inv, Functor.map_comp, Category.assoc,
    Functor.Monoidal.μIso_hom]
  congr 4
  rw [← Functor.map_comp_assoc, Iso.inv_hom_id, CategoryTheory.Functor.map_id,
    Category.id_comp]

end M5

/-! ### The bundle -/

/-- The five inputs together, for fixed `p, q, r, n`.  A structure with five fields, each of
which is one of the structures above; it adds nothing to them. -/
structure DeletionInterface (K : Type) [Field K] (p q r n : ℕ) where
  m1 : M1.{v₁, u₁} q r n
  m2 : M2.{v₁, v₂, u₁, u₂} p m1
  m3 : M3 m2
  m4N : M4.{v₂, v₃, u₂, u₃} K r (n + q) m2.BN
  m4n : M4.{v₂, v₃, u₂, u₃} K r n m2.Bn
  m5 : M5.{v₂, v₃, v₄, u₂, u₃, u₄} m4N m4n m3.Φ

end DegreeProfilesReview.Deletion
