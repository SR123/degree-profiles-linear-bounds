/-
Prompt 02, items 5–7: the categorical descent, in separable layers.

Everything here is abstract category theory proved from mathlib.  A "Serre quotient functor
with kernel `S`" is modelled as a localization functor for `S.isoModSerre` (the morphisms
whose kernel and cokernel lie in the Serre class `S`); this is the universal property of the
Serre quotient.

1. `localization_equivalence`: an equivalence `E : C₁ ≌ C₂` with `W₁ f ↔ W₂ (E f)` induces
   an equivalence of the localizations, commuting with the localization functors.
2. `serreClosure`: the Serre class generated by a class of objects; `serreClosure_iff`: an
   exact equivalence matching the generators (up to isomorphism) matches the generated Serre
   classes.  THIS is where kernel preservation is *derived* (not assumed) from a matching of
   simple labels.
3. `serre_quotient_equivalence`: item 6 of Prompt 02.
4. `concrete_functor_isEquivalence`: item 7 of Prompt 02 — any functor `Φ : D₁ ⥤ D₂` with a
   NATURAL isomorphism `L₁ ⋙ Φ ≅ E ⋙ L₂` (source Lemma 7.3.2) is isomorphic to the descended
   equivalence, hence is itself an equivalence.  Objectwise isomorphisms would not suffice;
   the hypothesis is a natural isomorphism of functors.
5. `boundedTail_descent`: the combination with the partition lemmas of `StablePartitions`:
   if the simple labels are matched by first-row deletion and the two Schur kernels are
   generated by the `p`-singular labels, then the concrete functor is an equivalence of the
   Schur images.  The inputs imported from the source (Theorem 8.4.5 with label control,
   Schur-quotient structure, Lemma 7.3.2) are explicit hypotheses; see `DEPENDENCIES.md`.
-/
import Mathlib.CategoryTheory.Localization.Equivalence
import Mathlib.CategoryTheory.Abelian.SerreClass.MorphismProperty
import Mathlib.CategoryTheory.Limits.Preserves.Shapes.Kernels
import DegreeProfilesReview.StablePartitions

open CategoryTheory CategoryTheory.Limits ZeroObject

namespace DegreeProfilesReview.SerreDescent

universe v₁ v₂ v₃ v₄ u₁ u₂ u₃ u₄

/-! ### 1. Equivalent sources with matched morphism classes have equivalent localizations -/

section Localization

variable {C₁ : Type u₁} [Category.{v₁} C₁] {C₂ : Type u₂} [Category.{v₂} C₂]
  {D₁ : Type u₃} [Category.{v₃} D₁] {D₂ : Type u₄} [Category.{v₄} D₂]

theorem localization_equivalence (L₁ : C₁ ⥤ D₁) (W₁ : MorphismProperty C₁)
    [L₁.IsLocalization W₁] (L₂ : C₂ ⥤ D₂) (W₂ : MorphismProperty C₂) [L₂.IsLocalization W₂]
    [W₂.RespectsIso] (E : C₁ ≌ C₂)
    (hW : ∀ {X Y : C₁} (f : X ⟶ Y), W₁ f ↔ W₂ (E.functor.map f)) :
    ∃ e : D₁ ≌ D₂, Nonempty (L₁ ⋙ e.functor ≅ E.functor ⋙ L₂) := by
  let L₁' : C₂ ⥤ D₁ := E.inverse ⋙ L₁
  have hW₁ : W₁ ≤ W₂.isoClosure.inverseImage E.functor := fun X Y f hf =>
    W₂.le_isoClosure _ ((hW f).mp hf)
  have hW₂ : W₂.IsInvertedBy L₁' := by
    intro X Y f hf
    have harrow : Arrow.mk (E.functor.map (E.inverse.map f)) ≅ Arrow.mk f :=
      Arrow.isoMk (E.counitIso.app X) (E.counitIso.app Y) (by simp)
    have h1 : W₁ (E.inverse.map f) := (hW _).mpr ((W₂.arrow_mk_iso_iff harrow).mpr hf)
    exact Localization.inverts L₁ W₁ _ h1
  let iso : E.functor ⋙ L₁' ≅ L₁ :=
    (Functor.associator _ _ _).symm ≪≫ Functor.isoWhiskerRight E.unitIso.symm L₁ ≪≫
      L₁.leftUnitor
  haveI : L₁'.IsLocalization W₂ :=
    Functor.IsLocalization.of_equivalence_source L₁ W₁ L₁' W₂ E hW₁ hW₂ iso
  refine ⟨Localization.uniq L₁' L₂ W₂, ⟨?_⟩⟩
  exact Functor.isoWhiskerRight iso.symm _ ≪≫ Functor.associator _ _ _ ≪≫
    Functor.isoWhiskerLeft E.functor (Localization.compUniqFunctor L₁' L₂ W₂)

/-- Item 7 in abstract form: a functor between the localized categories that commutes with
the localization functors up to NATURAL isomorphism is an equivalence. -/
theorem isEquivalence_of_comm (L₁ : C₁ ⥤ D₁) (W₁ : MorphismProperty C₁)
    [L₁.IsLocalization W₁] (L₂ : C₂ ⥤ D₂) (W₂ : MorphismProperty C₂) [L₂.IsLocalization W₂]
    [W₂.RespectsIso] (E : C₁ ≌ C₂)
    (hW : ∀ {X Y : C₁} (f : X ⟶ Y), W₁ f ↔ W₂ (E.functor.map f))
    (Φ : D₁ ⥤ D₂) (comm : L₁ ⋙ Φ ≅ E.functor ⋙ L₂) : Φ.IsEquivalence := by
  obtain ⟨e, ⟨he⟩⟩ := localization_equivalence L₁ W₁ L₂ W₂ E hW
  haveI : Localization.Lifting L₁ W₁ (L₁ ⋙ e.functor) e.functor := ⟨Iso.refl _⟩
  haveI : Localization.Lifting L₁ W₁ (L₁ ⋙ Φ) Φ := ⟨Iso.refl _⟩
  have iso : e.functor ≅ Φ :=
    Localization.liftNatIso L₁ W₁ (L₁ ⋙ e.functor) (L₁ ⋙ Φ) e.functor Φ (he ≪≫ comm.symm)
  exact Functor.isEquivalence_of_iso iso

end Localization

/-! ### 2. Serre classes generated by objects, and their transport -/

section Serre

variable {C₁ : Type u₁} [Category.{v₁} C₁] [Abelian C₁]
  {C₂ : Type u₂} [Category.{v₂} C₂] [Abelian C₂]

/-- The Serre class generated by a class of objects `T`: the intersection of all Serre
classes containing `T`.  (For `T` a set of simple objects in a finite-length category this is
the class of objects all of whose composition factors lie in `T`.) -/
def serreClosure {C : Type u₁} [Category.{v₁} C] [Abelian C] (T : ObjectProperty C) :
    ObjectProperty C :=
  fun X => ∀ P : ObjectProperty C, P.IsSerreClass → T ≤ P → P X

instance serreClosure_isSerreClass {C : Type u₁} [Category.{v₁} C] [Abelian C]
    (T : ObjectProperty C) : (serreClosure T).IsSerreClass where
  exists_zero := ⟨0, isZero_zero C, fun P hP _ => by
    haveI := hP
    exact P.prop_of_isZero (isZero_zero C)⟩
  prop_of_mono f _ hY := fun P hP hTP => by
    haveI := hP
    exact P.prop_of_mono f (hY P hP hTP)
  prop_of_epi f _ hX := fun P hP hTP => by
    haveI := hP
    exact P.prop_of_epi f (hX P hP hTP)
  prop_X₂_of_shortExact hS h₁ h₃ := fun P hP hTP => by
    haveI := hP
    exact P.prop_X₂_of_shortExact hS (h₁ P hP hTP) (h₃ P hP hTP)

theorem le_serreClosure {C : Type u₁} [Category.{v₁} C] [Abelian C] (T : ObjectProperty C) :
    T ≤ serreClosure T :=
  fun _ hX _ _ hTP => hTP _ hX

theorem serreClosure_le {C : Type u₁} [Category.{v₁} C] [Abelian C] {T P : ObjectProperty C}
    [hP : P.IsSerreClass] (h : T ≤ P) : serreClosure T ≤ P :=
  fun _ hX => hX P hP h

/-- An exact functor pulls the generated Serre class back into the generated Serre class,
provided it maps generators to generators. -/
theorem serreClosure_map (F : C₁ ⥤ C₂) [PreservesFiniteLimits F] [PreservesFiniteColimits F]
    {T₁ : ObjectProperty C₁} {T₂ : ObjectProperty C₂}
    (hT : ∀ X, T₁ X → serreClosure T₂ (F.obj X)) {X : C₁} (hX : serreClosure T₁ X) :
    serreClosure T₂ (F.obj X) := by
  intro P hP hTP
  haveI := hP
  have hle : T₁ ≤ P.inverseImage F := fun Y hY => hT Y hY P hP hTP
  exact hX (P.inverseImage F) inferInstance hle

/-- **Kernel matching, derived.**  If an exact equivalence sends generators to the generated
class in both directions, it identifies the two generated Serre classes. -/
theorem serreClosure_iff (E : C₁ ≌ C₂) {T₁ : ObjectProperty C₁} {T₂ : ObjectProperty C₂}
    (h₁ : ∀ X, T₁ X → serreClosure T₂ (E.functor.obj X))
    (h₂ : ∀ Y, T₂ Y → serreClosure T₁ (E.inverse.obj Y)) (X : C₁) :
    serreClosure T₁ X ↔ serreClosure T₂ (E.functor.obj X) := by
  constructor
  · exact serreClosure_map E.functor h₁
  · intro h
    have h' := serreClosure_map E.inverse h₂ h
    intro P hP hTP
    haveI := hP
    exact P.prop_of_iso (E.unitIso.app X).symm (h' P hP hTP)

end Serre

/-! ### 3. Exact equivalences matching the kernels induce equivalences of Serre quotients -/

section Quotient

variable {C₁ : Type u₁} [Category.{v₁} C₁] [Abelian C₁]
  {C₂ : Type u₂} [Category.{v₂} C₂] [Abelian C₂]
  {D₁ : Type u₃} [Category.{v₃} D₁] {D₂ : Type u₄} [Category.{v₄} D₂]

theorem isoModSerre_map_iff (S₁ : ObjectProperty C₁) [S₁.IsSerreClass]
    (S₂ : ObjectProperty C₂) [S₂.IsSerreClass] (E : C₁ ≌ C₂)
    (hS : ∀ X, S₁ X ↔ S₂ (E.functor.obj X)) {X Y : C₁} (f : X ⟶ Y) :
    S₁.isoModSerre f ↔ S₂.isoModSerre (E.functor.map f) := by
  rw [ObjectProperty.isoModSerre_iff, ObjectProperty.isoModSerre_iff,
    ObjectProperty.monoModSerre_iff, ObjectProperty.monoModSerre_iff,
    ObjectProperty.epiModSerre_iff, ObjectProperty.epiModSerre_iff, hS, hS,
    S₂.prop_iff_of_iso (PreservesKernel.iso E.functor f),
    S₂.prop_iff_of_iso (PreservesCokernel.iso E.functor f)]

/-- Prompt 02, item 6: an exact equivalence identifying the kernels of two Serre quotient
functors induces an equivalence of the quotient categories, compatible with the quotient
functors. -/
theorem serre_quotient_equivalence (S₁ : ObjectProperty C₁) [S₁.IsSerreClass]
    (S₂ : ObjectProperty C₂) [S₂.IsSerreClass]
    (L₁ : C₁ ⥤ D₁) [L₁.IsLocalization S₁.isoModSerre]
    (L₂ : C₂ ⥤ D₂) [L₂.IsLocalization S₂.isoModSerre]
    (E : C₁ ≌ C₂) (hS : ∀ X, S₁ X ↔ S₂ (E.functor.obj X)) :
    ∃ e : D₁ ≌ D₂, Nonempty (L₁ ⋙ e.functor ≅ E.functor ⋙ L₂) :=
  localization_equivalence L₁ _ L₂ _ E (fun f => isoModSerre_map_iff S₁ S₂ E hS f)

/-- Prompt 02, item 7: the concrete functor, commuting with the quotient functors up to a
natural isomorphism, is an equivalence of the quotient categories. -/
theorem concrete_functor_isEquivalence (S₁ : ObjectProperty C₁) [S₁.IsSerreClass]
    (S₂ : ObjectProperty C₂) [S₂.IsSerreClass]
    (L₁ : C₁ ⥤ D₁) [L₁.IsLocalization S₁.isoModSerre]
    (L₂ : C₂ ⥤ D₂) [L₂.IsLocalization S₂.isoModSerre]
    (E : C₁ ≌ C₂) (hS : ∀ X, S₁ X ↔ S₂ (E.functor.obj X))
    (Φ : D₁ ⥤ D₂) (comm : L₁ ⋙ Φ ≅ E.functor ⋙ L₂) : Φ.IsEquivalence :=
  isEquivalence_of_comm L₁ _ L₂ _ E (fun f => isoModSerre_map_iff S₁ S₂ E hS f) Φ comm

end Quotient

/-! ### 5. The bounded-tail descent, conditional on the precisely stated source inputs -/

section BoundedTail

open DegreeProfilesReview.StablePartitions

variable {C₁ : Type u₁} [Category.{v₁} C₁] [Abelian C₁]
  {C₂ : Type u₂} [Category.{v₂} C₂] [Abelian C₂]
  {D₁ : Type u₃} [Category.{v₃} D₁] {D₂ : Type u₄} [Category.{v₄} D₂]

/-- Objects isomorphic to a simple object with a `p`-singular bounded-tail label. -/
def singularGenerators {C : Type u₁} [Category.{v₁} C] (p t r : Nat) (Lab : List Nat → C) :
    ObjectProperty C :=
  fun X => ∃ l, BoundedTail t r l ∧ ¬ PRegular p l ∧ Nonempty (Lab l ≅ X)

/-- **Bounded-tail descent.**  Parameters `2 ≤ p`, `n > 2r`, `N = n + q`.

Explicit inputs (NOT proved here):
* `E`       : the restricted polynomial-functor equivalence `C_(N,r) ≌ C_(n,r)`
              (source Theorem 8.4.5 restricted to bounded-tail labels);
* `hLab`    : its simple-label action `L_(λᵗ) ↦ L_((λ - q e₁)ᵗ)` (source Lemma 8.4.3);
* `L₁, L₂`  : the Schur functors, as Serre quotient functors whose kernels are the Serre
              classes generated by the `p`-singular labels (source Cor. 8.5.2(2) / §7.3);
* `Φ, comm` : the concrete OTI functor on the Schur images and its natural commutation with
              the Schur functors (source Lemma 7.3.2).

Derived here: the two Schur kernels are matched (using `pRegular_delFirst_iff` and the
deletion bijection), and consequently `Φ` is an equivalence `B_(N,r) ≌ B_(n,r)`. -/
theorem boundedTail_descent {p q r n : Nat} (hp : 2 ≤ p) (hn : 2 * r < n)
    (Lab₁ : List Nat → C₁) (Lab₂ : List Nat → C₂) (E : C₁ ≌ C₂)
    (hLab : ∀ l, BoundedTail (n + q) r l → Nonempty (E.functor.obj (Lab₁ l) ≅ Lab₂ (delFirst q l)))
    (L₁ : C₁ ⥤ D₁)
    [hL₁ : L₁.IsLocalization
      (serreClosure (singularGenerators p (n + q) r Lab₁)).isoModSerre]
    (L₂ : C₂ ⥤ D₂)
    [hL₂ : L₂.IsLocalization (serreClosure (singularGenerators p n r Lab₂)).isoModSerre]
    (Φ : D₁ ⥤ D₂) (comm : L₁ ⋙ Φ ≅ E.functor ⋙ L₂) : Φ.IsEquivalence := by
  apply concrete_functor_isEquivalence
    (serreClosure (singularGenerators p (n + q) r Lab₁))
    (serreClosure (singularGenerators p n r Lab₂)) L₁ L₂ E _ Φ comm
  apply serreClosure_iff
  · -- singular source generators go to singular target generators
    rintro X ⟨l, hl, hsing, ⟨iX⟩⟩
    apply le_serreClosure
    obtain ⟨hdel, _, _⟩ := delFirst_boundedTail (q := q) hn hl
    refine ⟨delFirst q l, hdel, ?_, ?_⟩
    · rwa [← pRegular_delFirst_iff hp hn hl]
    · obtain ⟨i⟩ := hLab l hl
      exact ⟨i.symm ≪≫ E.functor.mapIso iX⟩
  · -- and conversely, through the inverse bijection `addFirst`
    rintro Y ⟨m, hm, hsing, ⟨iY⟩⟩
    apply le_serreClosure
    obtain ⟨hadd, _, hdeladd⟩ := addFirst_boundedTail (q := q) hn hm
    refine ⟨addFirst q m, hadd, ?_, ?_⟩
    · rw [pRegular_delFirst_iff hp hn hadd, hdeladd]
      exact hsing
    · obtain ⟨i⟩ := hLab (addFirst q m) hadd
      rw [hdeladd] at i
      exact ⟨(E.unitIso.app _) ≪≫ E.inverse.mapIso (i ≪≫ iY)⟩

end BoundedTail

end DegreeProfilesReview.SerreDescent
